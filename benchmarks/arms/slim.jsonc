// Name: Slim benchmark config
// Purpose: No MCP servers and a 400-line tool output cap, used by the coordinator-slim and direct-slim arms of the cost/performance A/B.
// Usage: ./benchmarks/harness/run.sh --arm coordinator-slim|direct-slim --workspace <checkout> --task <task.json>
// Validation: tests/unit/test_benchmark_arms.py; ./benchmarks/harness/run.sh --dry-run; make ci
// References: docs/benchmarks/methodology.md, docs/plans/cost-performance-optimization.md

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "**/.tmp*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {}
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": "15%"
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  }
}
