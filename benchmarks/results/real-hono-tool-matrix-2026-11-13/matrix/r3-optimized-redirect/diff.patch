+  it('c.redirect() percent-encodes raw CR and LF in the Location header', async () => {
+    const res = c.redirect('https://example.com/\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() percent-encodes a lone CR and a lone LF', async () => {
+    let res = c.redirect('/destination\rX-Injected: 1')
