diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..fd4a91f 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,50 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming option', () => {
+  const app = new Hono()
+  app.use('/trust', requestId({ trustIncoming: true }))
+  app.use('/no-trust', requestId({ trustIncoming: false }))
+  app.use('/no-trust-generator', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust-generator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    const reqId = res.headers.get('X-Request-Id')
+    expect(reqId).toMatch(regexUUIDv4)
+    expect(reqId).not.toBe('incoming-id')
+    expect(await res.text()).toBe(reqId)
+  })
+
+  it('Should always use the configured generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust-generator', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should generate a request id when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/no-trust')
+    expect(res.status).toBe(200)
+    const reqId = res.headers.get('X-Request-Id')
+    expect(reqId).toMatch(regexUUIDv4)
+    expect(await res.text()).toBe(reqId)
+  })
+})
