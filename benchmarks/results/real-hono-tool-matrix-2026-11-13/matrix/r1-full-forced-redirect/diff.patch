+  it('c.redirect() encodes raw CR/LF in Location to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+  })
+
+  it('c.redirect() encodes a lone CR and a lone LF', () => {
+    expect(c.redirect('/cr\ronly').headers.get('Location')).toBe('/cr%0Donly')
+    expect(c.redirect('/lf\nonly').headers.get('Location')).toBe('/lf%0Aonly')
+  })
+
+  it('c.redirect() encodes CR/LF alongside multibyte characters', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: 1')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%201'
+    )
+  })
+
+  it('c.redirect() preserves percent-encoded CR/LF inputs', () => {
+    for (const location of [
+      '/destination%0D%0ASet-Cookie:%20injected=1',
+      '/destination%0d%0aSet-Cookie:%20injected=1',
+    ]) {
+      expect(c.redirect(location).headers.get('Location')).toBe(location)
+    }
+  })
+
