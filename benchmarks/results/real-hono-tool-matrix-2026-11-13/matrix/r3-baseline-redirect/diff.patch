+  it('c.redirect() encodes raw CR/LF', () => {
+    const res = c.redirect('https://example.com/\r\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0AX-Injected: true')
+  })
+
+  it('c.redirect() encodes raw CR/LF with multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20true'
+    )
+  })
+
+  it('c.redirect() preserves percent-encoded CR/LF', () => {
+    const res = c.redirect('https://example.com/%0d%0aX-Injected: true')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0d%0aX-Injected: true')
+  })
