+  it('Should preserve both existing and new Set-Cookie headers when re-assigning c.res', () => {
+    const middlewareCookie = 'middleware=1; Path=/'
+    const handlerCookie = 'handler=2; Path=/'
+
+    // Middleware has already set a cookie on c.res
+    c.res.headers.append('set-cookie', middlewareCookie)
+
+    // A handler returns a new Response with its own Set-Cookie header
+    c.res = new Response('ok', {
+      headers: { 'set-cookie': handlerCookie },
+    })
+
+    // Both cookies must survive the merge
+    expect(c.res.headers.getSetCookie()).toEqual([middlewareCookie, handlerCookie])
+  })
+
+  it('Should not duplicate Set-Cookie headers when the new Response is derived from c.res', () => {
+    c.res.headers.append('set-cookie', 'session=abc; Path=/')
+
+    // e.g. compress or pretty-json middleware rebuilding the response with c.res as init
+    c.res = new Response('ok', c.res)
+
+    expect(c.res.headers.getSetCookie()).toEqual(['session=abc; Path=/'])
+  })
+
+  it('Should deduplicate multiple cookies when the new Response is derived from c.res', () => {
+    c.res.headers.append('set-cookie', 'a=1; Path=/')
+    c.res.headers.append('set-cookie', 'b=2; Path=/')
+
+    c.res = new Response('ok', c.res)
+
+    expect(c.res.headers.getSetCookie()).toEqual(['a=1; Path=/', 'b=2; Path=/'])
+  })
+
+  it('Should keep Set-Cookie headers unchanged when c.res is re-assigned to itself', () => {
+    c.res.headers.append('set-cookie', 'session=abc; Path=/')
+
+    c.res = c.res
+
+    expect(c.res.headers.getSetCookie()).toEqual(['session=abc; Path=/'])
   })
 
