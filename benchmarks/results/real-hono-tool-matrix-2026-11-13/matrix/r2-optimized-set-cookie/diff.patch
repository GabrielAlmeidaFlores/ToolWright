+    // The handler then returns a new Response with its own Set-Cookie header
+    c.res = new Response('ok', {
+      headers: {
+        'set-cookie': 'handler=1; Path=/',
+      },
+    })
+
+    expect(c.res.headers.getSetCookie()).toEqual(['middleware=1; Path=/', 'handler=1; Path=/'])
