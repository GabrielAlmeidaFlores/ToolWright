+  it('c.redirect() encodes raw CR and LF', () => {
+    let res = c.redirect('https://example.com/\r\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0A')
+
+    res = c.redirect('/destination\r')
+    expect(res.headers.get('Location')).toBe('/destination%0D')
+
+    res = c.redirect('/destination\n')
+    expect(res.headers.get('Location')).toBe('/destination%0A')
+  })
+
+  it('c.redirect() encodes raw CR/LF after multibyte characters', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\n')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A'
+    )
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR/LF', () => {
+    let res = c.redirect('https://example.com/%0D%0A')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0A')
+
+    res = c.redirect('/destination?next=%0D%0A')
+    expect(res.headers.get('Location')).toBe('/destination?next=%0D%0A')
+  })
+
+  it('c.redirect() prevents header injection via CRLF', () => {
+    const res = c.redirect('/destination\r\nX-Injected: value')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: value')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
