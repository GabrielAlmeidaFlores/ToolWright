diff --git a/src/context.test.ts b/src/context.test.ts
index 1fa06da..9ca86ae 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -440,7 +440,31 @@ describe('Context header', () => {
     const newResponse = new Response(null)
     newResponse.headers.append('set-cookie', newCookies[0])
     c.res = newResponse
-    expect(c.res.headers.getSetCookie().length).toBe(cookies.length)
+    expect(c.res.headers.getSetCookie().length).toBe(cookies.length + newCookies.length)
+    expect(c.res.headers.getSetCookie()).toEqual([...cookies, ...newCookies])
+  })
+
+  it('Should keep cookies set by middleware and the returned Response', () => {
+    // Middleware sets a cookie on `c.res`
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+
+    // The handler returns a new Response with its own `Set-Cookie` header
+    const handlerResponse = new Response('ok', {
+      headers: { 'set-cookie': 'handler=1; Path=/' },
+    })
+    c.res = handlerResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual(['middleware=1; Path=/', 'handler=1; Path=/'])
+  })
+
+  it('Should not duplicate cookies copied into the incoming Response', () => {
+    const cookies = ['a=1; Path=/', 'b=2; Path=/']
+    for (const cookie of cookies) {
+      c.res.headers.append('set-cookie', cookie)
+    }
+
+    // `c.text()` copies the existing headers into the new Response
+    c.res = c.text('ok')
     expect(c.res.headers.getSetCookie()).toEqual(cookies)
   })
 
