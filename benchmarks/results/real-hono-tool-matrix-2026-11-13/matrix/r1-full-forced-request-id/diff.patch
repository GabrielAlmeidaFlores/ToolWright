diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..9cff21f 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,102 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generateId = () => 'generated-request-id'
+  const app = new Hono()
+  app.use('/default', requestId({ generator: generateId }))
+  app.use('/trusted', requestId({ generator: generateId, trustIncoming: true }))
+  app.use('/untrusted', requestId({ generator: generateId, trustIncoming: false }))
+  app.use(
+    '/untrusted-custom-header',
+    requestId({ generator: generateId, trustIncoming: false, headerName: 'Hono-Request-Id' })
+  )
+  app.use(
+    '/untrusted-no-header',
+    requestId({ generator: generateId, trustIncoming: false, headerName: '' })
+  )
+  for (const path of [
+    '/default',
+    '/trusted',
+    '/untrusted',
+    '/untrusted-custom-header',
+    '/untrusted-no-header',
+  ]) {
+    app.get(path, (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  }
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should use the generated request id when no incoming header is present', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should ignore an invalid incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'Hello!12345-@*^',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should write the generated request id to a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-custom-header', {
+      headers: {
+        'Hono-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-request-id')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should not set a response header when headerName is empty and trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-no-header', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('generated-request-id')
+  })
+})
