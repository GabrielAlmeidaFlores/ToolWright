+describe('Request ID Middleware with trustIncoming', () => {
+  const generator = () => 'generated-request-id'
+
+  const trustedApp = new Hono()
+  trustedApp.use('/requestId', requestId({ generator, trustIncoming: true }))
+  trustedApp.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  const untrustedApp = new Hono()
+  untrustedApp.use('/requestId', requestId({ generator, trustIncoming: false }))
+  untrustedApp.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use the incoming request id when trustIncoming is true', async () => {
+    const res = await trustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await untrustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should generate the request id when trustIncoming is false and no header is sent', async () => {
+    const res = await untrustedApp.request('http://localhost/requestId')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+})
+
