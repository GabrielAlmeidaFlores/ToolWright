diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..7a2392b 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,68 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+  const app = new Hono()
+  app.use('/default', requestId({ generator: () => generatedId }))
+  app.use('/trust', requestId({ trustIncoming: true, generator: () => generatedId }))
+  app.use('/no-trust', requestId({ trustIncoming: false, generator: () => generatedId }))
+  app.use(
+    '/no-trust-custom-header',
+    requestId({ headerName: 'Hono-Request-Id', trustIncoming: false, generator: () => generatedId })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust-custom-header', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should ignore the incoming request id and use the generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should ignore the incoming request id for a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust-custom-header', {
+      headers: {
+        'Hono-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+  })
+})
