+  it('c.redirect() percent-encodes CR and LF to prevent header injection', async () => {
+    let res = c.redirect('/destination\r\nX-Injected: yes')
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: yes')
+    expect(res.headers.get('X-Injected')).toBeNull()
+
+    res = c.redirect('/destination\rX-Injected: yes')
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: yes')
+
+    res = c.redirect('/destination\nX-Injected: yes')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: yes')
+  })
+
+  it('c.redirect() percent-encodes CR and LF in multibyte URLs', async () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: yes')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20yes'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() preserves already percent-encoded CR and LF', async () => {
+    const res = c.redirect('/destination%0D%0AX-Injected: yes')
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: yes')
+  })
