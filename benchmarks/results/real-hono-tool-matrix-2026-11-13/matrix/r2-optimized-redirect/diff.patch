diff --git a/src/context.test.ts b/src/context.test.ts
index 1fa06da..bbf56bf 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,40 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() percent-encodes raw CR/LF in the Location header', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+  })
+
+  it('c.redirect() percent-encodes a raw CR or LF on its own', () => {
+    expect(c.redirect('/destination\rX-Evil: 1').headers.get('Location')).toBe(
+      '/destination%0DX-Evil: 1'
+    )
+    expect(c.redirect('/destination\nX-Evil: 1').headers.get('Location')).toBe(
+      '/destination%0AX-Evil: 1'
+    )
+  })
+
+  it('c.redirect() percent-encodes CR/LF when the location also has multibyte characters', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Evil: 1')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Evil:%201'
+    )
+  })
+
+  it('c.redirect() leaves already percent-encoded CR/LF untouched', () => {
+    const location = '/destination%0D%0ASet-Cookie:%20injected=1'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
+
+  it('c.redirect() leaves lowercase percent-encoded CR/LF untouched', () => {
+    const location = '/destination%0d%0aSet-Cookie:%20injected=1'
+    expect(c.redirect(location).headers.get('Location')).toBe(location)
+  })
+
   it('c.body() - Blob', async () => {
