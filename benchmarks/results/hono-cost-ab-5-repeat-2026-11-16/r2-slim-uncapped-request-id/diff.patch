diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..9c03db4 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,65 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  function generateFixedId() {
+    return 'generated-request-id'
+  }
+
+  const app = new Hono()
+  app.use('/trusted', requestId())
+  app.use('/untrusted', requestId({ trustIncoming: false, generator: generateFixedId }))
+  app.use(
+    '/untrustedWithHeader',
+    requestId({ trustIncoming: false, headerName: 'Hono-Request-Id', generator: generateFixedId })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedWithHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should ignore the incoming custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedWithHeader', {
+      headers: {
+        'Hono-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-request-id')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should use the generator when trustIncoming is false and no header', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+})
