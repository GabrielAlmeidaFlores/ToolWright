diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..b391abe 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,85 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/default', requestId())
+  app.use(
+    '/untrusted',
+    requestId({ trustIncoming: false, generator: () => 'generated-request-id' })
+  )
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: () => 'generated-request-id',
+    })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should use incoming request id when trustIncoming is not specified', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should ignore incoming request id and generate a new one when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+    expect(res.headers.get('X-Request-Id')).not.toBe('incoming-request-id')
+  })
+
+  it('Should ignore incoming request id with a custom header name when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'incoming-request-id',
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+    expect(res.headers.get('Hono-Request-Id')).not.toBe('incoming-request-id')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+  })
+
+  it('Should generate a request id when no incoming header is present and trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+})
