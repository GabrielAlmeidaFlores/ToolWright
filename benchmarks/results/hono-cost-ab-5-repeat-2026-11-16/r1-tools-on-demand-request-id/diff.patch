diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..6f98eab 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,78 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedRequestId = 'generated-request-id'
+  const incomingRequestId = 'hono-is-hot'
+
+  const app = new Hono()
+  app.use(
+    '/customGenerator',
+    requestId({ trustIncoming: false, generator: () => generatedRequestId })
+  )
+  app.use('/defaultGenerator', requestId({ trustIncoming: false }))
+  app.use('/trustIncoming', requestId({ trustIncoming: true }))
+  app.use('/customHeader', requestId({ trustIncoming: false, headerName: 'Hono-Request-Id' }))
+  app.get('/customGenerator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/defaultGenerator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trustIncoming', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/customHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should ignore the incoming header and use the generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/customGenerator', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedRequestId)
+    expect(res.headers.get('X-Request-Id')).not.toBe(incomingRequestId)
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+
+  it('Should generate a random id instead of using the incoming header', async () => {
+    const res = await app.request('http://localhost/defaultGenerator', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    const requestIdHeader = res.headers.get('X-Request-Id')
+    expect(requestIdHeader).toMatch(regexUUIDv4)
+    expect(requestIdHeader).not.toBe(incomingRequestId)
+    const body = await res.text()
+    expect(body).toMatch(regexUUIDv4)
+    expect(body).not.toBe(incomingRequestId)
+    expect(body).toBe(requestIdHeader)
+  })
+
+  it('Should use the incoming request id header when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trustIncoming', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(incomingRequestId)
+    expect(await res.text()).toBe(incomingRequestId)
+  })
+
+  it('Should expose the generated id via a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/customHeader', {
+      headers: {
+        'Hono-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    const requestIdHeader = res.headers.get('Hono-Request-Id')
+    expect(requestIdHeader).toMatch(regexUUIDv4)
+    expect(requestIdHeader).not.toBe(incomingRequestId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(requestIdHeader)
+  })
+})
