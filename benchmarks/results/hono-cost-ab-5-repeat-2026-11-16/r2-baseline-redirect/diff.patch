+  it('c.redirect() encodes raw CR and LF in the Location header', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=true')
+  })
+
+  it('c.redirect() encodes raw CR and LF individually', () => {
+    expect(c.redirect('/destination\rfoo').headers.get('Location')).toBe('/destination%0Dfoo')
+    expect(c.redirect('/destination\nfoo').headers.get('Location')).toBe('/destination%0Afoo')
+  })
+
+  it('c.redirect() encodes raw CR and LF after multibyte encoding', () => {
+    const res = c.redirect('/こんにちは\r\nSet-Cookie: injected=true')
+    expect(res.headers.get('Location')).toBe(
+      '/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0ASet-Cookie:%20injected=true'
+    )
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF', () => {
+    const encodedURLs = [
+      '/destination%0D%0ASet-Cookie: injected=true',
+      '/destination%0d%0aSet-Cookie: injected=true',
+      '/destination%0Dfoo',
+      '/destination%0Afoo',
+    ]
+    for (const urlString of encodedURLs) {
+      expect(c.redirect(urlString).headers.get('Location')).toBe(urlString)
+    }
+  })
+
