+      'handler=1; Path=/; HttpOnly',
+    ])
+    expect(await c.res.text()).toBe('ok')
+  })
+
+  it('Should not duplicate Set-Cookie headers when the new response is built from `c.res`', async () => {
+    c.res = new Response('first', {
+      headers: {
+        'set-cookie': 'foo=bar; Path=/',
+      },
+    })
+    c.res = new Response('second', c.res)
+    expect(c.res.headers.getSetCookie()).toEqual(['foo=bar; Path=/'])
