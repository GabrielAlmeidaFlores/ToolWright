diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..05efdfb 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,69 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming option', () => {
+  const generatedId = 'generated-id'
+  const generator = () => generatedId
+
+  const app = new Hono()
+  app.use('/trustIncoming', requestId({ trustIncoming: true, generator }))
+  app.use('/doNotTrustIncoming', requestId({ trustIncoming: false, generator }))
+  app.use(
+    '/doNotTrustIncomingCustomHeader',
+    requestId({ trustIncoming: false, headerName: 'Hono-Request-Id', generator })
+  )
+  app.use(
+    '/doNotTrustIncomingEmptyHeader',
+    requestId({ trustIncoming: false, headerName: '', generator })
+  )
+  app.get('/trustIncoming', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/doNotTrustIncoming', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/doNotTrustIncomingCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/doNotTrustIncomingEmptyHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trustIncoming', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/doNotTrustIncoming', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should always generate a request id with a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/doNotTrustIncomingCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should generate a request id without setting a header when headerName is empty and trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/doNotTrustIncomingEmptyHeader')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+  })
+})
