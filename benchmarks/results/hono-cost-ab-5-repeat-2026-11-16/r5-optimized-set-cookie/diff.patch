   init?: globalThis.ResponseInit
 ): Response => new Response(body, init)
 
+// `Set-Cookie` is the only multi-value header, so it must be merged, not set.
+// The earlier cookies come first so the later, more specific ones can override them.
+const mergeSetCookieHeaders = (headers: Headers, earlier: string[], later: string[]) => {
+  headers.delete('set-cookie')
+  for (const cookie of earlier) {
+    // A response derived from the current one already carries its cookies
+    if (!later.includes(cookie)) {
+      headers.append('set-cookie', cookie)
+    }
+  }
+  for (const cookie of later) {
+    headers.append('set-cookie', cookie)
+  }
+}
