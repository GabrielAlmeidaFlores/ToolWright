+describe('Set-Cookie merging', () => {
+  it('Should keep the middleware cookie when the handler returns its own Set-Cookie header', async () => {
+    const app = new Hono()
+    app.use('*', async (_c, next) => {
+      _c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+      await next()
+    })
+    app.get('/', () => new Response('ok', { headers: { 'set-cookie': 'handler=1; Path=/' } }))
+
+    const res = await app.request('/')
+    expect(res.headers.getSetCookie()).toEqual(['middleware=1; Path=/', 'handler=1; Path=/'])
+  })
+
+  it('Should keep the cookie set by `setCookie()` when the handler returns its own Set-Cookie header', async () => {
+    const app = new Hono()
+    app.use('*', async (c, next) => {
+      setCookie(c, 'middleware', '1', { path: '/' })
+      await next()
+    })
+    app.get('/', () => new Response('ok', { headers: { 'set-cookie': 'handler=1; Path=/' } }))
+
+    const res = await app.request('/')
+    expect(res.headers.getSetCookie()).toEqual(['middleware=1; Path=/', 'handler=1; Path=/'])
+  })
+
+  it('Should not duplicate cookies when the new response is derived from the current response', () => {
+    const c = new Context(new Request('http://localhost/'))
+    c.res = new Response(null, { headers: { 'set-cookie': 'foo=bar; Path=/' } })
+
+    // `c.text()` derives its headers from the current `c.res`, cookies included
+    c.res = c.text('hi')
+    expect(c.res.headers.getSetCookie()).toEqual(['foo=bar; Path=/'])
+  })
+
+  it('Should keep cookies once when assigning `c.res` to itself', () => {
+    const c = new Context(new Request('http://localhost/'))
+    c.res = new Response(null, {
+      headers: [
+        ['set-cookie', 'foo=bar; Path=/'],
+        ['set-cookie', 'foo2=bar2; Path=/'],
+      ],
+    })
+
+    // Self-assignment keeps each cookie once
+    const res = c.res
+    c.res = res
+    expect(c.res.headers.getSetCookie()).toEqual(['foo=bar; Path=/', 'foo2=bar2; Path=/'])
+  })
+
+  it('Should not duplicate the handler cookie when middleware overwrites the response after `next()`', async () => {
+    const app = new Hono()
+    app.use('*', async (c, next) => {
+      await next()
+      c.res = c.text('overwritten')
+    })
+    app.get('/', (c) => {
+      setCookie(c, 'handler', '1', { path: '/' })
+      return c.text('hi')
+    })
+
+    const res = await app.request('/')
+    expect(res.headers.getSetCookie()).toEqual(['handler=1; Path=/'])
+  })
+
+  it('Should keep the middleware and handler cookies once when overwriting after `next()`', async () => {
+    const app = new Hono()
+    app.use('*', async (c, next) => {
+      c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+      await next()
+      c.res = c.text('overwritten')
+    })
+    app.get('/', () => new Response('ok', { headers: { 'set-cookie': 'handler=1; Path=/' } }))
+
+    const res = await app.request('/')
+    expect(res.headers.getSetCookie()).toEqual(['middleware=1; Path=/', 'handler=1; Path=/'])
+  })
+})
