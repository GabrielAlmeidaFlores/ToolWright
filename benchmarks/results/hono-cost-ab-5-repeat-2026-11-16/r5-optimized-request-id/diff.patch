diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..915f6f1 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,109 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+  const generate = () => generatedId
+
+  describe('trustIncoming: false', () => {
+    const app = new Hono()
+    app.use('/requestId', requestId({ trustIncoming: false, generator: generate }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    it('Should ignore an incoming valid request id header', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'hono-is-hot',
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+      expect(await res.text()).toBe(generatedId)
+    })
+
+    it('Should ignore an incoming invalid request id header', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'Hello!12345-@*^',
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+      expect(await res.text()).toBe(generatedId)
+    })
+
+    it('Should ignore an incoming over-long request id header', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'h'.repeat(256),
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+      expect(await res.text()).toBe(generatedId)
+    })
+  })
+
+  describe('trustIncoming: false with custom header', () => {
+    const app = new Hono()
+    app.use(
+      '/requestId',
+      requestId({ trustIncoming: false, headerName: 'Hono-Request-Id', generator: generate })
+    )
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    it('Should expose the generated id on the custom header and ignore X-Request-Id', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'hono-is-hot',
+          'Hono-Request-Id': 'hono-is-hot',
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Hono-Request-Id')).toBe(generatedId)
+      expect(res.headers.get('X-Request-Id')).toBeNull()
+      expect(await res.text()).toBe(generatedId)
+    })
+  })
+
+  describe('trustIncoming: true', () => {
+    const app = new Hono()
+    app.use('/requestId', requestId({ trustIncoming: true, generator: generate }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    it('Should preserve an incoming valid request id header', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'hono-is-hot',
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+      expect(await res.text()).toBe('hono-is-hot')
+    })
+  })
+
+  describe('trustIncoming omitted', () => {
+    const app = new Hono()
+    app.use('/requestId', requestId({ generator: generate }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    it('Should preserve an incoming valid request id header', async () => {
+      const res = await app.request('http://localhost/requestId', {
+        headers: {
+          'X-Request-Id': 'hono-is-hot',
+        },
+      })
+      expect(res).not.toBeNull()
+      expect(res.status).toBe(200)
+      expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+      expect(await res.text()).toBe('hono-is-hot')
+    })
+  })
+})
