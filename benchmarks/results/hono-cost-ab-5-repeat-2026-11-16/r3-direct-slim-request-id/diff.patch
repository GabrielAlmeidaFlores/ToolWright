diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..b441b92 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,67 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ trustIncoming: false }))
+  app.use(
+    '/untrustedCustom',
+    requestId({ trustIncoming: false, generator: () => 'generated-by-generator' })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustom', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust an incoming request id header by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should trust an incoming request id header when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore an incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(res.headers.get('X-Request-Id')).not.toBe('incoming-id')
+    expect(await res.text()).toMatch(regexUUIDv4)
+  })
+
+  it('Should always use the generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustom', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-by-generator')
+    expect(await res.text()).toBe('generated-by-generator')
+  })
+})
