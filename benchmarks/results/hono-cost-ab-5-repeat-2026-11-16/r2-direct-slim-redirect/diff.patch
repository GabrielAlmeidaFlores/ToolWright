+  it('c.redirect() w/ raw CR/LF', () => {
+    let res = c.redirect('/destination\r\nSet-Cookie: evil=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: evil=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+
+    res = c.redirect('/destination\rSet-Cookie: evil=1')
+    expect(res.headers.get('Location')).toBe('/destination%0DSet-Cookie: evil=1')
+
+    res = c.redirect('/destination\nSet-Cookie: evil=1')
+    expect(res.headers.get('Location')).toBe('/destination%0ASet-Cookie: evil=1')
+  })
+
+  it('c.redirect() w/ raw CR/LF and multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nSet-Cookie: evil=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0ASet-Cookie:%20evil=1'
+    )
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() w/ percent-encoded CR/LF', () => {
+    const urlStrings = [
+      'https://example.com/%0D%0ASet-Cookie:%20evil=1',
+      '/destination%0DSet-Cookie:%20evil=1',
+      '/destination%0ASet-Cookie:%20evil=1',
+    ]
+    for (const urlString of urlStrings) {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    }
+  })
+
