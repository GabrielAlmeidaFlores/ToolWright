@@ -115,6 +115,48 @@ describe('Context', () => {
     )
   })
 
+  it('c.redirect() percent-encodes raw CR and LF to prevent header injection', async () => {
+    // Raw CR
+    let res = c.redirect('/destination\rX-Injected: yes')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: yes')
+
+    // Raw LF
+    res = c.redirect('/destination\nX-Injected: yes')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: yes')
+
+    // Raw CRLF
+    res = c.redirect('/destination\r\nX-Injected: yes')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: yes')
+
+    // Every occurrence is encoded
+    res = c.redirect('/a\r\nb\nc\rd')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/a%0D%0Ab%0Ac%0Dd')
+
+    // Multibyte input combined with CR/LF encodes both
+    res = c.redirect('/こんにちは\r\nX-Injected: yes')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      '/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20yes'
+    )
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR and LF', async () => {
+    const urlString = '/destination%0D%0AX-Injected:%20yes'
+    const res = c.redirect(urlString)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(urlString)
+  })
+
+  it('c.redirect() still preserves valid redirect responses', async () => {
+    const res = c.redirect('https://example.com/path?query=value#fragment')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/path?query=value#fragment')
+  })
+
   const unchangedURLString = [
