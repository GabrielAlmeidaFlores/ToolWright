+  it('c.redirect() encodes a raw LF in the Location header', () => {
+    const res = c.redirect('/destination\nevil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0Aevil')
+  })
+
+  it('c.redirect() encodes a raw CR in the Location header', () => {
+    const res = c.redirect('/destination\revil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0Devil')
+  })
+
+  it('c.redirect() encodes a CRLF header injection payload', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() does not double-encode already percent-encoded CRLF', () => {
+    const res = c.redirect('https://example.com/%0D%0ASet-Cookie:%20injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0ASet-Cookie:%20injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
