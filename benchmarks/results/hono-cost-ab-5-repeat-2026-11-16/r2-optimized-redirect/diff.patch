+  it('c.redirect() encodes raw CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw CR', () => {
+    const res = c.redirect('/destination\rLocation: https://evil.example')
+    expect(res.headers.get('Location')).toBe('/destination%0DLocation: https://evil.example')
+  })
+
+  it('c.redirect() encodes raw LF', () => {
+    const res = c.redirect('/destination\nX-Injected: 1')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: 1')
+  })
+
+  it('c.redirect() w/ multibytes and CRLF', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\n')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A'
+    )
+  })
+
+  const alreadyEncodedURLString = [
+    'https://example.com/%0D%0A',
+    'https://example.com/%0d%0a',
+    'https://example.com/?next=%0D%0ASet-Cookie',
+  ]
+
+  alreadyEncodedURLString.forEach((urlString) => {
+    it(`c.redirect() does not double-encode ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
+
