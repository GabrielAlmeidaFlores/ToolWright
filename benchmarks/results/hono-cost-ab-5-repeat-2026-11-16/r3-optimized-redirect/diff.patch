+  it('c.redirect() encodes raw CR to prevent header injection', () => {
+    const res = c.redirect('/destination\rX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw LF to prevent header injection', () => {
+    const res = c.redirect('/destination\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CRLF', () => {
+    const res = c.redirect('/destination%0D%0AX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw CRLF in multibyte locations', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    // `encodeURI` (multibyte branch) also turns the space into `%20`.
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%201'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
