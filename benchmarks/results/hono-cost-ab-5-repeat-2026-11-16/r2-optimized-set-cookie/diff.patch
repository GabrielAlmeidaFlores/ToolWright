+  it('Should keep cookies set by middleware and by the handler response', async () => {
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+
+    c.res = new Response('ok', {
+      headers: {
+        'set-cookie': 'handler=2; Path=/',
+      },
+    })
+
+    const cookies = c.res.headers.getSetCookie()
+    expect(cookies.length).toBe(2)
+    expect(cookies).toEqual(['middleware=1; Path=/', 'handler=2; Path=/'])
+    expect(cookies.includes('middleware=1; Path=/')).toBe(true)
+    expect(cookies.includes('handler=2; Path=/')).toBe(true)
+
+    // The rest of the incoming response is preserved.
+    expect(c.res.status).toBe(200)
+    expect(c.res.headers.get('content-type')).toBe('text/plain;charset=UTF-8')
+    expect(await c.res.text()).toBe('ok')
   })
 
