+
+  it('Should merge multiple cookies when re-assigning Response to `c.res`', () => {
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+    c.res.headers.append('set-cookie', 'middleware=2; Path=/')
+    c.res = new Response('body', {
