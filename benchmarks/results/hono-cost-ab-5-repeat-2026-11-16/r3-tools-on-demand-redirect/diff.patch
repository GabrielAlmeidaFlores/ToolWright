diff --git a/src/context.test.ts b/src/context.test.ts
index 1fa06da..6e9ff19 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,38 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() w/ raw CRLF is percent-encoded', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: hacked=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: hacked=1')
+  })
+
+  it('c.redirect() w/ raw LF is percent-encoded', () => {
+    const res = c.redirect('/destination\nfoo')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0Afoo')
+  })
+
+  it('c.redirect() w/ raw CR is percent-encoded', () => {
+    const res = c.redirect('/destination\rfoo')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0Dfoo')
+  })
+
+  it('c.redirect() w/ percent-encoded CRLF is not double-encoded', () => {
+    const res = c.redirect('https://example.com/destination%0D%0AX-Injected:true')
+    expect(res.headers.get('Location')).toBe('https://example.com/destination%0D%0AX-Injected:true')
+    const resLowerCase = c.redirect('https://example.com/%0d%0a')
+    expect(resLowerCase.headers.get('Location')).toBe('https://example.com/%0d%0a')
+  })
+
+  it('c.redirect() w/ multibytes and raw CRLF is percent-encoded', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nx')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0Ax'
+    )
+  })
+
   it('c.body() - Blob', async () => {
     const res = c.body(new Blob(['Hi']))
     expect(await res.text()).toBe('Hi')
