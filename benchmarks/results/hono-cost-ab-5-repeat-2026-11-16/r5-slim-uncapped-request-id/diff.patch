diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..128bf4b 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,47 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'trusted-incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('trusted-incoming-id')
+    expect(await res.text()).toBe('trusted-incoming-id')
+  })
+
+  it('Should ignore incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'untrusted-incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore invalid request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'Hello!12345-@*^',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
