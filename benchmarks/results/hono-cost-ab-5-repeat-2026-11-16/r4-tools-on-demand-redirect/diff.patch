+  it('c.redirect() encodes CRLF to prevent header injection', async () => {
+    const res = c.redirect('https://example.com/\r\nSet-Cookie: session=evil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%0D%0ASet-Cookie: session=evil'
+    )
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes a lone CR', () => {
+    const res = c.redirect('https://example.com/a\rb')
+    expect(res.headers.get('Location')).toBe('https://example.com/a%0Db')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes a lone LF', () => {
+    const res = c.redirect('https://example.com/a\nb')
+    expect(res.headers.get('Location')).toBe('https://example.com/a%0Ab')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() does not double-encode already encoded CRLF', () => {
+    const locationString = 'https://example.com/%0D%0ASet-Cookie: session=evil'
+    const res = c.redirect(locationString)
+    expect(res.headers.get('Location')).toBe(locationString)
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes CRLF with multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nSet-Cookie: session=evil')
+    const location = res.headers.get('Location') ?? ''
+    expect(location).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0ASet-Cookie:%20session=evil'
+    )
+    expect(location).not.toMatch(/[\r\n]/)
+    expect(location).toContain('%0D%0A')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
