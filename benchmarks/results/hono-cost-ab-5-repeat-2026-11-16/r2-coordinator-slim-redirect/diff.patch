index 1fa06da..3c9c3c3 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,50 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() encodes a raw CR in the Location header', () => {
+    const res = c.redirect('/a\rb')
+    const location = res.headers.get('Location')
+    expect(res.status).toBe(302)
+    expect(location).toBe('/a%0Db')
+    expect(location).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() encodes a raw LF in the Location header', () => {
+    const res = c.redirect('/a\nb')
+    const location = res.headers.get('Location')
+    expect(res.status).toBe(302)
+    expect(location).toBe('/a%0Ab')
+    expect(location).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() encodes a raw CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nX-Injected: evil')
+    const location = res.headers.get('Location')
+    expect(res.status).toBe(302)
+    expect(location).toBe('/destination%0D%0AX-Injected: evil')
+    expect(location).not.toMatch(/[\r\n]/)
+    expect(res.headers.get('X-Injected')).toBe(null)
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CRLF', () => {
+    const res = c.redirect('/destination%0D%0AX-Injected: evil')
+    const location = res.headers.get('Location')
+    expect(res.status).toBe(302)
+    expect(location).toBe('/destination%0D%0AX-Injected: evil')
+    expect(location).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() encodes raw CRLF combined with multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: evil')
+    const location = res.headers.get('Location')
+    expect(res.status).toBe(302)
+    expect(location).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20evil'
+    )
+    expect(location).not.toMatch(/[\r\n]/)
+    expect(res.headers.get('X-Injected')).toBe(null)
+  })
+
