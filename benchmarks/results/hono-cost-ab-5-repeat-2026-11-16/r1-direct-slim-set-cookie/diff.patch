+
+  it('Should keep both middleware and handler cookies when the handler returns a new Response', () => {
+    // Simulate middleware setting a cookie on `c.res` before the handler runs.
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+
+    // Simulate the handler returning a Response with its own `Set-Cookie` header.
+    const handlerResponse = new Response('ok', {
+      headers: { 'set-cookie': 'handler=1; Path=/' },
+    })
+    c.res = handlerResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'middleware=1; Path=/',
+      'handler=1; Path=/',
+    ])
+  })
+
+  it('Should keep the handler cookies when the middleware response has no cookies', () => {
+    c.res.headers.set('x-middleware', '1')
+    c.res = new Response('ok', {
+      headers: { 'set-cookie': 'handler=1; Path=/' },
+    })
+
+    expect(c.res.headers.getSetCookie()).toEqual(['handler=1; Path=/'])
+    expect(c.res.headers.get('x-middleware')).toBe('1')
+  })
+
+  it('Should keep cookies set by middleware and the handler in an app', async () => {
+    const app = new Hono()
+    app.use('*', async (c, next) => {
+      c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+      await next()
+    })
+    app.get(
+      '/',
+      () =>
+        new Response('ok', {
+          headers: { 'set-cookie': 'handler=1; Path=/' },
+        })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.getSetCookie()).toEqual([
+      'middleware=1; Path=/',
+      'handler=1; Path=/',
+    ])
   })
 
