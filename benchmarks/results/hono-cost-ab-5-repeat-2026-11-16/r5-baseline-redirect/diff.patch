+  it('c.redirect() encodes CR and LF in the Location header', () => {
+    const cases = [
+      ['/destination\rSet-Cookie: hacked=1', '/destination%0DSet-Cookie: hacked=1'],
+      ['/destination\nSet-Cookie: hacked=1', '/destination%0ASet-Cookie: hacked=1'],
+      ['/destination\r\nSet-Cookie: hacked=1', '/destination%0D%0ASet-Cookie: hacked=1'],
+    ] as const
+    cases.forEach(([location, expected]) => {
+      const res = c.redirect(location)
+      expect(res.headers.get('Location')).toBe(expected)
+      expect(res.headers.get('Set-Cookie')).toBeNull()
+    })
+  })
+
+  it('c.redirect() keeps percent-encoded CR and LF unchanged', () => {
+    const location = '/destination%0D%0ASet-Cookie:%20hacked=1'
+    const res = c.redirect(location)
+    expect(res.headers.get('Location')).toBe(location)
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
