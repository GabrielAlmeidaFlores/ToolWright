+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/trusted', requestId())
+  app.use('/untrusted', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.use(
+    '/untrusted-with-custom-header',
+    requestId({
+      headerName: 'Hono-Request-Id',
+      trustIncoming: false,
+      generator: () => 'generated-id',
+    })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted-with-custom-header', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should generate a request id when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore the incoming request id with a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-with-custom-header', {
+      headers: {
+        'Hono-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-id')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('generated-id')
+  })
+})
+
