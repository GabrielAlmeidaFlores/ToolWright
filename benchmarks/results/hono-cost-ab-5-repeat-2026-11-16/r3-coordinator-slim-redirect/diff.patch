+  it('c.redirect() encodes raw CR', () => {
+    const res = c.redirect('/foo\rbar')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/foo%0Dbar')
+  })
+
+  it('c.redirect() encodes raw LF', () => {
+    const res = c.redirect('/foo\nbar')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/foo%0Abar')
+  })
+
+  it('c.redirect() encodes raw CRLF (header injection attempt)', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    const location = res.headers.get('Location')
+    expect(location).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(location).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CRLF', () => {
+    const res = c.redirect('https://example.com/%0d%0a')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0d%0a')
+  })
+
+  it('c.redirect() does not double-encode percent-encoded URL components', () => {
+    const location = 'https://example.com/redirect?url=https%3A%2F%2Fexample.com&q=a%20b'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
+
+  it('c.redirect() encodes raw CRLF after multibyte encoding without double-encoding', () => {
+    const res = c.redirect('/こんにちは\r\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A')
+  })
+
+  it('c.redirect() encodes raw CRLF in an absolute URL', () => {
+    const res = c.redirect('https://example.com/a\r\nb')
+    expect(res.status).toBe(302)
+    const location = res.headers.get('Location')
+    expect(location).toBe('https://example.com/a%0D%0Ab')
+    expect(location).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() preserves uppercase percent-encoded CRLF', () => {
+    const res = c.redirect('https://example.com/%0D%0A')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0A')
+  })
