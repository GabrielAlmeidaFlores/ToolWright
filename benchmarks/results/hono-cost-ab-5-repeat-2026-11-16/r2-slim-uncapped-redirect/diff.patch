+  it('c.redirect() encodes raw CR/LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=true')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes a lone raw CR and LF', () => {
+    expect(c.redirect('/destination\rhere').headers.get('Location')).toBe('/destination%0Dhere')
+    expect(c.redirect('/destination\nhere').headers.get('Location')).toBe('/destination%0Ahere')
+  })
+
+  it('c.redirect() preserves percent-encoded CR/LF', () => {
+    const location = '/destination%0D%0ASet-Cookie: injected=true'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
