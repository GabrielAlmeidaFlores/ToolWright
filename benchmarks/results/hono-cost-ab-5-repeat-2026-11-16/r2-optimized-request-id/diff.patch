+
+describe('Request ID Middleware with trustIncoming disabled', () => {
+  const generatedRequestId = 'generated-request-id_123'
+
+  const app = new Hono()
+  app.use('/requestId', requestId({ trustIncoming: false, generator: () => generatedRequestId }))
+  app.use(
+    '/customHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: () => generatedRequestId,
+    })
+  )
+  app.use(
+    '/emptyHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: '',
+      generator: () => generatedRequestId,
+    })
+  )
+  app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/customHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/emptyHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should ignore the incoming request id header and use the generator', async () => {
+    const res = await app.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedRequestId)
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+
+  it('Should set the custom header name with the generated request id', async () => {
+    const res = await app.request('http://localhost/customHeader', {
+      headers: {
+        'Hono-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedRequestId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+
+  it('Should expose the generated request id without setting a response header', async () => {
+    const res = await app.request('http://localhost/emptyHeader', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+})
