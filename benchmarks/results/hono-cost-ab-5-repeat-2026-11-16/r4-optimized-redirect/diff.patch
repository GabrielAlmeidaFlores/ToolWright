@@ -129,6 +129,40 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() encodes CR and LF in the Location header', () => {
+    const res = c.redirect('/destination\r\nX-Injected: true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: true')
+    expect(res.headers.get('Location')).not.toMatch(/[\r\n]/)
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes a lone CR and a lone LF', () => {
+    let res = c.redirect('/destination\rX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: true')
+    res = c.redirect('/destination\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: true')
+  })
+
+  it('c.redirect() encodes CR and LF with multibyte characters', () => {
+    const res = c.redirect('/こんにちは\r\nX-Injected: true')
+    const location = res.headers.get('Location')
+    expect(location).toContain('%0D%0A')
+    expect(location).not.toMatch(/[\r\n]/)
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() keeps percent-encoded CR and LF unchanged', () => {
+    for (const location of [
+      '/destination%0d%0aX-Injected:%20true',
+      '/destination%0D%0ASet-Cookie:%20injected=true',
+    ]) {
+      const res = c.redirect(location)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(location)
+    }
+  })
+
   it('c.body() - Blob', async () => {
