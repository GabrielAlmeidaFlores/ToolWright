+    expect(lfRes.headers.get('Location')).toBe('/a%0Ab')
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CRLF', async () => {
+    const lowercase = '/destination%0d%0aX-Injected%3A%20true'
+    const uppercase = '/destination%0D%0AX-Injected%3A%20true'
+    expect(c.redirect(lowercase).headers.get('Location')).toBe(lowercase)
+    expect(c.redirect(uppercase).headers.get('Location')).toBe(uppercase)
+  })
