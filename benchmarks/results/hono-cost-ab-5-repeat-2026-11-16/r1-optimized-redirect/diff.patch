+  it('c.redirect() w/ CRLF injection', async () => {
+    const res = c.redirect('/destination\r\nX-Injected: evil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: evil')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() w/ CR', async () => {
+    const res = c.redirect('/destination\rX')
+    expect(res.headers.get('Location')).toBe('/destination%0DX')
+  })
+
+  it('c.redirect() w/ LF', async () => {
+    const res = c.redirect('/destination\nX')
+    expect(res.headers.get('Location')).toBe('/destination%0AX')
+  })
+
+  it('c.redirect() w/ percent-encoded CRLF', async () => {
+    const res = c.redirect('https://example.com/%0D%0A')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0A')
+  })
+
+  it('c.redirect() w/ multibytes and CRLF', async () => {
+    const res = c.redirect('https://example.com/こんにちは\r\n')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A'
+    )
+  })
