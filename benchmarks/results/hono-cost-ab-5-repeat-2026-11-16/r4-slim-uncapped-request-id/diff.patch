diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..94530a0 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -1,3 +1,4 @@
+import { vi } from 'vitest'
 import { requestId } from '.'
 import type { Context } from '../../context'
 import { Hono } from '../../hono'
@@ -166,3 +167,63 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const generator = vi.fn(() => generatedId)
+    const app = new Hono()
+    app.use('/requestId', requestId({ generator, trustIncoming: false }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    const res = await app.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(res.headers.get('X-Request-Id')).not.toBe('incoming-request-id')
+    expect(await res.text()).toBe(generatedId)
+    expect(generator).toHaveBeenCalledTimes(1)
+  })
+
+  it('Should use the incoming request id when trustIncoming is true', async () => {
+    const generator = vi.fn(() => generatedId)
+    const app = new Hono()
+    app.use('/requestId', requestId({ generator, trustIncoming: true }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    const res = await app.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(res.headers.get('X-Request-Id')).not.toBe(generatedId)
+    expect(await res.text()).toBe('incoming-request-id')
+    expect(generator).not.toHaveBeenCalled()
+  })
+
+  it('Should keep generating and not set a header with an empty headerName when trustIncoming is false', async () => {
+    const generator = vi.fn(() => generatedId)
+    const app = new Hono()
+    app.use('/requestId', requestId({ generator, headerName: '', trustIncoming: false }))
+    app.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    const res = await app.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+    expect(generator).toHaveBeenCalledTimes(1)
+  })
+})
