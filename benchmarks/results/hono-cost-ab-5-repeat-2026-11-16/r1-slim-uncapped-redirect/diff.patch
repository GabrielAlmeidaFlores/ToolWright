diff --git a/src/context.test.ts b/src/context.test.ts
index 1fa06da..bdd385b 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,36 @@ describe('Context', () => {
     })
   })
 
+  const crlfInjectionCases = [
+    ['\r', '%0D'],
+    ['\n', '%0A'],
+    ['\r\n', '%0D%0A'],
+  ]
+
+  crlfInjectionCases.forEach(([crlf, encoded]) => {
+    it(`c.redirect() encodes ${JSON.stringify(crlf)} in Location`, () => {
+      const res = c.redirect(`/destination${crlf}Set-Cookie: malicious=1`)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(`/destination${encoded}Set-Cookie: malicious=1`)
+      expect(res.headers.get('Set-Cookie')).toBeNull()
+    })
+  })
+
+  it('c.redirect() does not double encode percent-encoded CRLF', () => {
+    const location = '/destination%0D%0ASet-Cookie%3A%20malicious%3D1'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() preserves percent-encoded CRLF in a query value', () => {
+    const location = 'https://example.com/destination?message=hello%0Aworld'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
+
   it('c.body() - Blob', async () => {
     const res = c.body(new Blob(['Hi']))
     expect(await res.text()).toBe('Hi')
