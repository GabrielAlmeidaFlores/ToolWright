+  it('c.redirect() encodes raw CR and LF', () => {
+    let res = c.redirect('https://example.com/\r')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D')
+
+    res = c.redirect('https://example.com/\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0A')
+  })
+
+  it('c.redirect() prevents CRLF header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=true')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  const percentEncodedCRLFURLString = [
+    'https://example.com/%0D%0A',
+    'https://example.com/%0d%0a',
+    'https://example.com/?value=%0D%0A',
+  ]
+
+  percentEncodedCRLFURLString.forEach((urlString) => {
+    it(`c.redirect() preserves percent-encoded CR/LF in ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
+
