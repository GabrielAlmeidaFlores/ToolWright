+  it('c.redirect() encodes raw CR/LF in Location', () => {
+    const res = c.redirect('https://example.com/\r\nX-Injected: value')
+    const location = res.headers.get('Location')
+    expect(location).toBe('https://example.com/%0D%0AX-Injected: value')
+    expect(location).not.toContain('\r')
+    expect(location).not.toContain('\n')
+  })
+
+  it('c.redirect() encodes raw LF in Location', () => {
+    const res = c.redirect('/destination\nX-Injected: value')
+    const location = res.headers.get('Location')
+    expect(location).toBe('/destination%0AX-Injected: value')
+    expect(location).not.toContain('\n')
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR/LF', () => {
+    expect(c.redirect('https://example.com/%0D%0A').headers.get('Location')).toBe(
+      'https://example.com/%0D%0A'
+    )
+    expect(c.redirect('https://example.com/%0d%0a').headers.get('Location')).toBe(
+      'https://example.com/%0d%0a'
+    )
+  })
