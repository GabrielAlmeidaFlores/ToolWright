+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.use(
+    '/untrusted-custom-header',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: () => 'generated-id',
+    })
+  )
+  app.use(
+    '/untrusted-empty-header',
+    requestId({ trustIncoming: false, headerName: '', generator: () => 'generated-id' })
+  )
+  app.use(
+    '/untrusted-invalid',
+    requestId({ trustIncoming: false, generator: () => 'generated-id' })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted-custom-header', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted-empty-header', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted-invalid', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore the incoming custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-custom-header', {
+      headers: {
+        'Hono-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should not return a request id header when headerName is empty and trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-empty-header', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore an invalid incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted-invalid', {
+      headers: {
+        'X-Request-Id': 'Hello!12345-@*^',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
+
 describe('Request ID Middleware with custom header', () => {
   const app = new Hono()
   app.use('/requestId', requestId({ headerName: 'Hono-Request-Id' }))
