diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..1c5dc67 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,66 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generateWord = () => 'generated-request-id'
+
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use('/trust', requestId({ generator: generateWord, trustIncoming: true }))
+  app.use('/no-trust', requestId({ generator: generateWord, trustIncoming: false }))
+  app.use('/no-trust-uuid', requestId({ trustIncoming: false }))
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust-uuid', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should trust incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore incoming request id and use the generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-request-id')
+    expect(await res.text()).toBe('generated-request-id')
+  })
+
+  it('Should ignore incoming request id and generate a UUID when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust-uuid', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res.status).toBe(200)
+    const header = res.headers.get('X-Request-Id')
+    const body = await res.text()
+    expect(header).toMatch(regexUUIDv4)
+    expect(body).toMatch(regexUUIDv4)
+    expect(header).not.toBe('hono-is-hot')
+    expect(body).not.toBe('hono-is-hot')
+    expect(body).toBe(header)
+  })
+})
