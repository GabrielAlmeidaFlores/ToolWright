+  it('c.redirect() encodes raw CR and LF in Location', async () => {
+    let res = c.redirect('https://example.com/\rSet-Cookie: injected=1')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0DSet-Cookie: injected=1')
+
+    res = c.redirect('https://example.com/\nSet-Cookie: injected=1')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0ASet-Cookie: injected=1')
+
+    res = c.redirect('https://example.com/\r\nSet-Cookie: injected=1')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0ASet-Cookie: injected=1')
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF in Location', async () => {
+    const urlString = 'https://example.com/%0D%0ASet-Cookie:%20injected=1'
+    const res = c.redirect(urlString)
+    expect(res.headers.get('Location')).toBe(urlString)
+
+    const lowercaseURLString = 'https://example.com/%0d%0aSet-Cookie:%20injected=1'
+    const lowercaseRes = c.redirect(lowercaseURLString)
+    expect(lowercaseRes.headers.get('Location')).toBe(lowercaseURLString)
+  })
+
