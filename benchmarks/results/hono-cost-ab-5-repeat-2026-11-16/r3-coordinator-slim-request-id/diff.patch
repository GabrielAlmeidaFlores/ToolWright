+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-id'
+  const generatedCustomId = 'generated-custom-id'
+  const generatedEmptyHeaderNameId = 'generated-empty-header-name-id'
+  const generateId = vi.fn(() => generatedId)
+  const generateCustomId = vi.fn(() => generatedCustomId)
+  const generateEmptyHeaderNameId = vi.fn(() => generatedEmptyHeaderNameId)
+
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use(
+    '/untrusted',
+    requestId({
+      trustIncoming: false,
+      generator: generateId,
+    })
+  )
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: generateCustomId,
+    })
+  )
+  app.use(
+    '/untrustedEmptyHeaderName',
+    requestId({
+      trustIncoming: false,
+      headerName: '',
+      generator: generateEmptyHeaderNameId,
+    })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedEmptyHeaderName', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  beforeEach(() => {
+    generateId.mockClear()
+    generateCustomId.mockClear()
+    generateEmptyHeaderNameId.mockClear()
+  })
+
+  it('Should use the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+    expect(generateId).toHaveBeenCalledTimes(1)
+  })
+
+  it('Should generate a request id when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+    expect(generateId).toHaveBeenCalledTimes(1)
+  })
+
+  it('Should ignore the incoming request id for a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'incoming-custom-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedCustomId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedCustomId)
+    expect(generateCustomId).toHaveBeenCalledTimes(1)
+  })
+
+  it('Should not set a request id header when headerName is empty and trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedEmptyHeaderName', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedEmptyHeaderNameId)
+    expect(generateEmptyHeaderNameId).toHaveBeenCalledTimes(1)
+  })
+})
+
 describe('Request ID Middleware with custom header', () => {
   const app = new Hono()
   app.use('/requestId', requestId({ headerName: 'Hono-Request-Id' }))
