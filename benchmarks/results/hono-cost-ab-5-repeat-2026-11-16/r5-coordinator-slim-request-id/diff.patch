diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..a9169d0 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,87 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedRequestId = 'HonoIsWebFramework'
+  const incomingRequestId = 'hono-is-hot'
+
+  function generateWord() {
+    return generatedRequestId
+  }
+
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ generator: generateWord, trustIncoming: false }))
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({
+      generator: generateWord,
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+    })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust an incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(incomingRequestId)
+    expect(await res.text()).toBe(incomingRequestId)
+  })
+
+  it('Should trust an incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(incomingRequestId)
+    expect(await res.text()).toBe(incomingRequestId)
+  })
+
+  it('Should ignore an incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedRequestId)
+    expect(res.headers.get('X-Request-Id')).not.toBe(incomingRequestId)
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+
+  it('Should ignore an incoming custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: {
+        'Hono-Request-Id': incomingRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedRequestId)
+    expect(res.headers.get('Hono-Request-Id')).not.toBe(incomingRequestId)
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+
+  it('Should use the generator when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedRequestId)
+    expect(await res.text()).toBe(generatedRequestId)
+  })
+})
