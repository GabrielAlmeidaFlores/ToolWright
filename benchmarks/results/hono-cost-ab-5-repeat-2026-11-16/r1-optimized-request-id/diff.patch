diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..63400a8 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,86 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const defaultApp = new Hono()
+  defaultApp.use('*', requestId())
+  defaultApp.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  const trustedApp = new Hono()
+  trustedApp.use('*', requestId({ trustIncoming: true }))
+  trustedApp.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  const untrustedApp = new Hono()
+  untrustedApp.use('*', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  untrustedApp.get('/requestId', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await defaultApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await trustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await untrustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should use the generated request id when trustIncoming is false and no header is sent', async () => {
+    const res = await untrustedApp.request('http://localhost/requestId')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore a valid incoming request id when trustIncoming is false', async () => {
+    const validRequestId = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_='
+    const res = await untrustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': validRequestId,
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore a long incoming request id when trustIncoming is false', async () => {
+    const res = await untrustedApp.request('http://localhost/requestId', {
+      headers: {
+        'X-Request-Id': 'h'.repeat(256),
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
