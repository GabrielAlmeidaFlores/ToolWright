+describe('Request ID Middleware with trustIncoming', () => {
+  let generatedCount = 0
+  function generateSequentialId() {
+    generatedCount++
+    return `generated-${generatedCount}`
+  }
+
+  const app = new Hono()
+  app.use('/default', requestId({ generator: generateSequentialId }))
+  app.use('/trusted', requestId({ generator: generateSequentialId, trustIncoming: true }))
+  app.use('/untrusted', requestId({ generator: generateSequentialId, trustIncoming: false }))
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  beforeEach(() => {
+    generatedCount = 0
+  })
+
+  it('Should trust incoming request id header by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+    expect(generatedCount).toBe(0)
+  })
+
+  it('Should trust incoming request id header when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+    expect(generatedCount).toBe(0)
+  })
+
+  it('Should ignore incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-1')
+    expect(await res.text()).toBe('generated-1')
+    expect(generatedCount).toBe(1)
+  })
+
+  it('Should generate a request id when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-1')
+    expect(await res.text()).toBe('generated-1')
+    expect(generatedCount).toBe(1)
+  })
+})
+
