+  // Regression tests: raw CR/LF in Location must be percent-encoded (header injection)
+  it('c.redirect() encodes raw CR and LF to prevent header injection', async () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBe(null)
+
+    const lfRes = c.redirect('/foo\nbar')
+    expect(lfRes.headers.get('Location')).toBe('/foo%0Abar')
+
+    const crRes = c.redirect('/foo\rbar')
+    expect(crRes.headers.get('Location')).toBe('/foo%0Dbar')
+  })
+
+  it('c.redirect() encodes CR and LF together with multibytes', async () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nfoo')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0Afoo'
+    )
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR and LF', async () => {
+    const res = c.redirect('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+
+    const lowercaseRes = c.redirect('/a%0d%0ab')
+    expect(lowercaseRes.headers.get('Location')).toBe('/a%0d%0ab')
+  })
+
   const unchangedURLString = [
