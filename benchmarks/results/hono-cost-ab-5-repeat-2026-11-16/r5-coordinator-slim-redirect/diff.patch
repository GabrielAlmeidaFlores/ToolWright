+  it('c.redirect() does not allow CRLF header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes lone CR', () => {
+    const res = c.redirect('/a\rb')
+    expect(res.headers.get('Location')).toBe('/a%0Db')
+  })
+
+  it('c.redirect() encodes lone LF', () => {
+    const res = c.redirect('/a\nb')
+    expect(res.headers.get('Location')).toBe('/a%0Ab')
+  })
+
+  it('c.redirect() encodes CRLF after multibyte encoding', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX'
+    )
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CRLF', () => {
+    const res = c.redirect('https://example.com/%0d%0a')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0d%0a')
+  })
+
   it('c.body() - Blob', async () => {
