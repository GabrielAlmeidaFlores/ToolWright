diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..2db5d13 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,99 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming option', () => {
+  const app = new Hono()
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use(
+    '/untrusted',
+    requestId({
+      trustIncoming: false,
+      generator: () => 'HonoIsWebFramework',
+    })
+  )
+  app.use('/untrustedDefault', requestId({ trustIncoming: false }))
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: () => 'HonoIsWebFramework',
+    })
+  )
+  app.use(
+    '/untrustedLongHeader',
+    requestId({
+      trustIncoming: false,
+      limitLength: 5,
+      generator: () => 'HonoIsWebFramework',
+    })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedDefault', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedLongHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust an incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore an incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('HonoIsWebFramework')
+    expect(await res.text()).toBe('HonoIsWebFramework')
+  })
+
+  it('Should use the default generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedDefault', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).not.toBe('hono-is-hot')
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(await res.text()).toMatch(regexUUIDv4)
+  })
+
+  it('Should ignore an incoming request id with a custom header name when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('HonoIsWebFramework')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('HonoIsWebFramework')
+  })
+
+  it('Should ignore an incoming request id longer than limitLength when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedLongHeader', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('HonoIsWebFramework')
+    expect(await res.text()).toBe('HonoIsWebFramework')
+  })
+})
