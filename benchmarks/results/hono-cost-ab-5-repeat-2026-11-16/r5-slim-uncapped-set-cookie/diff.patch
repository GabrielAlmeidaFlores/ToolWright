+  it('Should keep both the context cookie and the response Set-Cookie header when re-assigning `c.res`', () => {
+    // Middleware sets a cookie on `c.res` before the handler runs.
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+
+    // The handler returns a new Response with its own Set-Cookie header.
+    const handlerResponse = new Response('ok', {
+      headers: [['set-cookie', 'handler=1; Path=/']],
+    })
+    c.res = handlerResponse
+
+    const cookies = c.res.headers.getSetCookie()
+    expect(cookies).toContain('middleware=1; Path=/')
+    expect(cookies).toContain('handler=1; Path=/')
+    expect(cookies.length).toBe(2)
+  })
+
+  it('Should not duplicate a cookie already inherited from `c.res`', () => {
+    c.res.headers.append('set-cookie', 'foo=bar; Path=/')
+    c.res = c.text('Hi')
+    expect(c.res.headers.getSetCookie()).toEqual(['foo=bar; Path=/'])
   })
 
