+  it('c.redirect() w/ CRLF injection payload', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() w/ lone CR and lone LF', () => {
+    const resCR = c.redirect('/a\rb')
+    expect(resCR.headers.get('Location')).toBe('/a%0Db')
+    const resLF = c.redirect('/a\nb')
+    expect(resLF.headers.get('Location')).toBe('/a%0Ab')
+  })
+
+  it('c.redirect() w/ already percent-encoded CRLF', () => {
+    const urlString = 'https://example.com/%0D%0ASet-Cookie:%20injected=1'
+    const res = c.redirect(urlString)
+    expect(res.headers.get('Location')).toBe(urlString)
+  })
+
+  it('c.redirect() w/ multibytes and CRLF', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Evil: 1')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Evil:%201'
+    )
+  })
+
   it('c.body() - Blob', async () => {
