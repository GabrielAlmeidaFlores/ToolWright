+  it('c.redirect() encodes raw CR and LF in Location header', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=true')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes a raw CR in Location header', () => {
+    const res = c.redirect('/destination\rX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: true')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes a raw LF in Location header', () => {
+    const res = c.redirect('/destination\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: true')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw CR and LF with multibytes in Location header', () => {
+    const res = c.redirect('/こんにちは\r\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe(
+      '/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20true'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
