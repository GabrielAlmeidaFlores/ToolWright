+  it('c.redirect() encodes raw CR and LF in the Location header', () => {
+    let res = c.redirect('/destination\rSet-Cookie: foo=bar')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0DSet-Cookie: foo=bar')
+
+    res = c.redirect('/destination\nSet-Cookie: foo=bar')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0ASet-Cookie: foo=bar')
+
+    res = c.redirect('/destination\r\nSet-Cookie: foo=bar')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: foo=bar')
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF in the Location header', () => {
+    const urls = [
+      '/destination%0DSet-Cookie:%20foo=bar',
+      '/destination%0ASet-Cookie:%20foo=bar',
+      '/destination%0D%0ASet-Cookie:%20foo=bar',
+      '/destination%0d%0aSet-Cookie:%20foo=bar',
+    ]
+
+    for (const url of urls) {
+      const res = c.redirect(url)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(url)
+    }
+  })
+
