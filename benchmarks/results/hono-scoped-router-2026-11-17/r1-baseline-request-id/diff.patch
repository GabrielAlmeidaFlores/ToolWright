+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+  const app = new Hono()
+  app.use('/trustIncoming', requestId({ trustIncoming: true }))
+  app.use('/ignoreIncoming', requestId({ trustIncoming: false, generator: () => generatedId }))
+  app.use(
+    '/ignoreIncomingCustomHeader',
+    requestId({
+      trustIncoming: false,
+      headerName: 'Hono-Request-Id',
+      generator: () => generatedId,
+    })
+  )
+  app.get('/trustIncoming', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/ignoreIncoming', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/ignoreIncomingCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trustIncoming', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/ignoreIncoming', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should ignore the incoming request id with a custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/ignoreIncomingCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+})
+
