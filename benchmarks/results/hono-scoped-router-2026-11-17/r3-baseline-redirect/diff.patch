diff --git a/src/context.test.ts b/src/context.test.ts
index 1fa06da..7fc78d7 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,39 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() encodes raw CR and LF in Location header', () => {
+    let res = c.redirect('/destination\r\nX-Injected: true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: true')
+
+    res = c.redirect('/destination\rX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: true')
+
+    res = c.redirect('/destination\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: true')
+  })
+
+  it('c.redirect() encodes raw CR and LF alongside multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20true'
+    )
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF in Location header', () => {
+    const encodedLocations = [
+      '/destination%0D%0AX-Injected: true',
+      '/destination%0d%0aX-Injected: true',
+      '/destination%0DX-Injected: true',
+      '/destination%0AX-Injected: true',
+    ]
+
+    for (const location of encodedLocations) {
+      const res = c.redirect(location)
+      expect(res.headers.get('Location')).toBe(location)
+    }
+  })
+
   it('c.body() - Blob', async () => {
     const res = c.body(new Blob(['Hi']))
     expect(await res.text()).toBe('Hi')
diff --git a/src/context.ts b/src/context.ts
index 6db8717..03d6a73 100644
--- a/src/context.ts
+++ b/src/context.ts
@@ -774,7 +774,10 @@ export class Context<
       'Location',
       // Multibytes should be encoded
       // eslint-disable-next-line no-control-regex
-      !/[^\x00-\xFF]/.test(locationString) ? locationString : encodeURI(locationString)
+      !/[^\x00-\xFF]/.test(locationString)
+        ? // Encode CR and LF to prevent header injection
+          locationString.replace(/[\r\n]/g, (char) => (char === '\r' ? '%0D' : '%0A'))
