diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..be61e49 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,59 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+
+  const app = new Hono()
+  app.use('/default', requestId({ generator: () => generatedId }))
+  app.use('/trust', requestId({ generator: () => generatedId, trustIncoming: true }))
+  app.use('/untrust', requestId({ generator: () => generatedId, trustIncoming: false }))
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should use incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should ignore incoming request id and use the generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should use the generator when trustIncoming is false and no request id is sent', async () => {
+    const res = await app.request('http://localhost/untrust')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+})
