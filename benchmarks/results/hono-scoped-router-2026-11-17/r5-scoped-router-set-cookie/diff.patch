+  it('Should keep both middleware and handler set-cookie headers', async () => {
+    // Simulate middleware setting a cookie before the handler runs.
+    c.res = new Response(null, {
+      headers: [['set-cookie', 'session=abc; Path=/']],
+    })
+
+    // Simulate a handler returning a new Response with its own cookie.
+    const handlerResponse = new Response('ok', {
+      headers: [['set-cookie', 'theme=dark; Path=/']],
+    })
+    c.res = handlerResponse
+
+    const cookies = c.res.headers.getSetCookie()
+    expect(cookies).toContain('session=abc; Path=/')
