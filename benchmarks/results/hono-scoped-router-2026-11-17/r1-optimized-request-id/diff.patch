diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..78707cb 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,67 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/noTrust', requestId({ trustIncoming: false, generator: () => 'TrustedGeneratedId' }))
+  app.use('/trust', requestId({ trustIncoming: true, generator: () => 'TrustedGeneratedId' }))
+  app.get('/noTrust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should always generate request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/noTrust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('TrustedGeneratedId')
+    expect(await res.text()).toBe('TrustedGeneratedId')
+  })
+
+  it('Should use incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'incoming-request-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-request-id')
+    expect(await res.text()).toBe('incoming-request-id')
+  })
+
+  it('Should generate request id when trustIncoming is false and no header is present', async () => {
+    const res = await app.request('http://localhost/noTrust')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('TrustedGeneratedId')
+    expect(await res.text()).toBe('TrustedGeneratedId')
+  })
+
+  it('Should generate request id when trustIncoming is false and header is invalid', async () => {
+    const res = await app.request('http://localhost/noTrust', {
+      headers: {
+        'X-Request-Id': 'Hello!12345-@*^',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('TrustedGeneratedId')
+    expect(await res.text()).toBe('TrustedGeneratedId')
+  })
+
+  it('Should generate request id when trustIncoming is false and header is too long', async () => {
+    const res = await app.request('http://localhost/noTrust', {
+      headers: {
+        'X-Request-Id': 'h'.repeat(256),
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('TrustedGeneratedId')
+    expect(await res.text()).toBe('TrustedGeneratedId')
+  })
+})
