+  it('c.redirect() encodes CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: pwned=1')
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: pwned=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+    expect(res.headers.get('Location')).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() encodes bare CR and bare LF', () => {
+    expect(c.redirect('/destination\rinjection').headers.get('Location')).toBe(
+      '/destination%0Dinjection'
+    )
+    expect(c.redirect('/destination\ninjection').headers.get('Location')).toBe(
+      '/destination%0Ainjection'
+    )
+  })
+
+  it('c.redirect() does not double encode percent-encoded CRLF', () => {
+    const urlString = 'https://example.com/%0D%0ASet-Cookie:%20pwned=1'
+    const res = c.redirect(urlString)
+    expect(res.headers.get('Location')).toBe(urlString)
+  })
+
+  it('c.redirect() encodes multibytes and CRLF together', () => {
+    const res = c.redirect('/こんにちは\r\nX: y')
+    expect(res.headers.get('Location')).toBe(
+      '/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX:%20y'
+    )
+  })
+
   it('c.body() - Blob', async () => {
     const res = c.body(new Blob(['Hi']))
     expect(await res.text()).toBe('Hi')
