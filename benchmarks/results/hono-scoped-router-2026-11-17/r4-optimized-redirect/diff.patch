+  it('c.redirect() should encode raw CR and LF to prevent header injection', async () => {
+    const res = c.redirect('https://example.com/destination\r\nSet-Cookie: evil=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/destination%0D%0ASet-Cookie: evil=1'
+    )
+  })
+
+  it('c.redirect() should encode a lone raw CR', async () => {
+    const res = c.redirect('https://example.com/a\rb')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/a%0Db')
+  })
+
+  it('c.redirect() should encode a lone raw LF', async () => {
+    const res = c.redirect('https://example.com/a\nb')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/a%0Ab')
+  })
+
+  it('c.redirect() should not double-encode existing %0D/%0A', async () => {
+    const res = c.redirect('https://example.com/destination%0D%0Atest')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/destination%0D%0Atest')
+  })
+
