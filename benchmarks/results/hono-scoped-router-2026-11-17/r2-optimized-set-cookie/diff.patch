+  it('Should keep cookies set by middleware and by a newly returned Response', () => {
+    // Middleware has already set a cookie on `c.res`
+    c.res.headers.append('set-cookie', 'middleware=1; Path=/')
+
+    // A handler returns a new Response carrying its own Set-Cookie header
+    const handlerResponse = new Response('OK', {
+      headers: { 'content-type': 'text/plain' },
+    })
+    handlerResponse.headers.append('set-cookie', 'handler=1; Path=/')
+
+    c.res = handlerResponse
+
+    const cookies = c.res.headers.getSetCookie()
+    expect(cookies.length).toBe(2)
+    expect(cookies.includes('middleware=1; Path=/')).toBe(true)
+    expect(cookies.includes('handler=1; Path=/')).toBe(true)
   })
 
