+  it('Should keep middleware cookies when a handler returns a Response with its own Set-Cookie header', () => {
+    // Middleware has already set a cookie on `c.res`
+    const middlewareResponse = new Response(null)
+    middlewareResponse.headers.append('set-cookie', 'middleware=1; Path=/')
+    c.res = middlewareResponse
+
+    // The handler returns a new Response with its own Set-Cookie header
+    c.res = new Response('ok', {
+      headers: {
+        'set-cookie': 'handler=1; Path=/',
+      },
+    })
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'middleware=1; Path=/',
