+  it('c.redirect() encodes raw CR and LF', async () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+
+    const resWithCR = c.redirect('/destination\rX-Injected: 1')
+    expect(resWithCR.headers.get('Location')).toBe('/destination%0DX-Injected: 1')
+
+    const resWithLF = c.redirect('/destination\nX-Injected: 1')
+    expect(resWithLF.headers.get('Location')).toBe('/destination%0AX-Injected: 1')
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF', async () => {
+    const location = '/destination%0D%0ASet-Cookie: injected=1'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+
+    const lowerCaseLocation = '/destination%0d%0aX-Injected: 1'
+    const lowerCaseRes = c.redirect(lowerCaseLocation)
+    expect(lowerCaseRes.headers.get('Location')).toBe(lowerCaseLocation)
+  })
