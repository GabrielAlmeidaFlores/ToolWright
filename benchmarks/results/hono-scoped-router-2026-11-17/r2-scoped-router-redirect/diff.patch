+  it('c.redirect() encodes raw CR to prevent header injection', () => {
+    const res = c.redirect('https://example.com/\rX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0DX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw LF to prevent header injection', () => {
+    const res = c.redirect('https://example.com/\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes raw CRLF to prevent header injection', () => {
+    const res = c.redirect('https://example.com/\r\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() preserves already percent-encoded CR and LF', () => {
+    const res = c.redirect('https://example.com/%0D%0AX-Injected:%201')
+    expect(res.status).toBe(302)
