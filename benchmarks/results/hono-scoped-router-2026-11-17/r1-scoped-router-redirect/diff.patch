+  it('c.redirect() percent-encodes CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nX-Injected: https://evil.example')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: https://evil.example')
+    expect(res.headers.get('X-Injected')).toBe(null)
+  })
+
+  it('c.redirect() percent-encodes a lone CR', () => {
+    const res = c.redirect('/destination\rX-Injected: https://evil.example')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: https://evil.example')
+    expect(res.headers.get('X-Injected')).toBe(null)
+  })
+
+  it('c.redirect() percent-encodes a lone LF', () => {
+    const res = c.redirect('/destination\nX-Injected: https://evil.example')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: https://evil.example')
+    expect(res.headers.get('X-Injected')).toBe(null)
+  })
+
+  it('c.redirect() percent-encodes CRLF while keeping the status code', () => {
+    const res = c.redirect('/destination\r\n', 301)
+    expect(res.status).toBe(301)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0A')
+  })
+
+  const percentEncodedURLString = [
+    'https://example.com/%0D%0ALocation%3A%20https%3A%2F%2Fevil.example',
+    'https://example.com/%0d%0aLocation%3a%20https%3a%2f%2fevil.example',
+    'https://example.com/?next=%0A%0D',
+  ]
+
+  percentEncodedURLString.forEach((urlString) => {
+    it(`c.redirect() does not double-encode ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
+
