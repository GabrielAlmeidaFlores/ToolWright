diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..5e8a83b 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,77 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming option', () => {
+  const app = new Hono()
+  app.use('/default', requestId())
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ trustIncoming: false }))
+  app.use(
+    '/untrustedCustomGenerator',
+    requestId({ trustIncoming: false, generator: () => 'alwaysThisId' })
+  )
+  const paths = ['/default', '/trusted', '/untrusted', '/untrustedCustomGenerator']
+  for (const path of paths) {
+    app.get(path, (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  }
+
+  it('Should trust the incoming request id header by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should trust the incoming request id header when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore the incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(res.headers.get('X-Request-Id')).not.toBe('hono-is-hot')
+    const body = await res.text()
+    expect(body).toMatch(regexUUIDv4)
+    expect(body).not.toBe('hono-is-hot')
+  })
+
+  it('Should always use the configured generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomGenerator', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('alwaysThisId')
+    expect(await res.text()).toBe('alwaysThisId')
+  })
+
+  it('Should generate a request id when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(await res.text()).toMatch(regexUUIDv4)
+  })
+})
