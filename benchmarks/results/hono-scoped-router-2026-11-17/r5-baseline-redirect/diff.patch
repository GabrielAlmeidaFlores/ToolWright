+  it('c.redirect() encodes raw CR and LF', () => {
+    let res = c.redirect('https://example.com/destination\r\nX-Injected: evil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/destination%0D%0AX-Injected: evil'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+
+    res = c.redirect('https://example.com/destination\r')
+    expect(res.headers.get('Location')).toBe('https://example.com/destination%0D')
+
+    res = c.redirect('https://example.com/destination\n')
+    expect(res.headers.get('Location')).toBe('https://example.com/destination%0A')
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF', () => {
+    const urlString = 'https://example.com/destination%0D%0AX-Injected: evil'
+    const res = c.redirect(urlString)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(urlString)
+    expect(res.headers.get('X-Injected')).toBeNull()
+
+    const lowercaseURLString = 'https://example.com/destination%0d%0a?next=%0D%0A'
+    expect(c.redirect(lowercaseURLString).headers.get('Location')).toBe(lowercaseURLString)
+  })
+
   const unchangedURLString = [
