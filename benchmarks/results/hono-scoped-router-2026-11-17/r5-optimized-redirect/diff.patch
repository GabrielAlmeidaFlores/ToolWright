@@ -129,6 +129,52 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() - happy path is unchanged', () => {
+    const res = c.redirect('/destination')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination')
+  })
+
+  it('c.redirect() - encodes CRLF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() - encodes a lone CR', () => {
+    const res = c.redirect('/destination\rX')
+    expect(res.headers.get('Location')).toBe('/destination%0DX')
+  })
+
+  it('c.redirect() - encodes a lone LF', () => {
+    const res = c.redirect('/destination\nX')
+    expect(res.headers.get('Location')).toBe('/destination%0AX')
+  })
+
+  it('c.redirect() - encodes CRLF while preserving the status code', () => {
+    const res = c.redirect('/destination\r\nX', 301)
+    expect(res.status).toBe(301)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX')
+  })
+
+  it('c.redirect() - does not double-encode already percent-encoded CRLF', () => {
+    const res = c.redirect('https://example.com/%0d%0a')
+    expect(res.headers.get('Location')).toBe('https://example.com/%0d%0a')
+  })
+
+  it('c.redirect() - encodes raw CRLF next to already percent-encoded CRLF', () => {
+    const res = c.redirect('/a%0d%0a\r\nb')
+    expect(res.headers.get('Location')).toBe('/a%0d%0a%0D%0Ab')
+  })
+
+  it('c.redirect() - encodes CRLF together with multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX'
+    )
+  })
+
   it('c.body() - Blob', async () => {
