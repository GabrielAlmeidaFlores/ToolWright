@@ -129,6 +129,53 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() - encodes raw CRLF to prevent header injection', () => {
+    let res!: Response
+    expect(() => {
+      res = c.redirect('/path\r\nSet-Cookie: injected=1')
+    }).not.toThrow()
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/path%0D%0ASet-Cookie: injected=1')
+    // The injected header must not have been split out into its own header
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() - encodes a raw CR to prevent header injection', () => {
+    const res = c.redirect('/path\rX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/path%0DX-Injected: 1')
+  })
+
+  it('c.redirect() - encodes a raw LF to prevent header injection', () => {
+    const res = c.redirect('/path\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/path%0AX-Injected: 1')
+  })
+
+  it('c.redirect() - does not double encode percent-encoded CRLF sequences', () => {
+    // Lowercase hex in the input must be preserved exactly as typed
+    let res = c.redirect('https://example.com/%0d%0a')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0d%0a')
+    res = c.redirect('/path%0D%0ASet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/path%0D%0ASet-Cookie: injected=1')
+  })
+
+  it('c.redirect() - encodes raw CRLF in a multibyte value', () => {
+    const res = c.redirect('/こんにちは\r\nX-Injected:1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      '/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:1'
+    )
+  })
+
+  it('c.redirect() - keeps valid absolute redirects verbatim', () => {
+    const res = c.redirect('https://example.com/destination?q=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/destination?q=1')
+  })
+
   it('c.body() - Blob', async () => {
