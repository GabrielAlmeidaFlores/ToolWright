+  it('c.redirect() percent-encodes raw CR and LF in Location', () => {
+    const res = c.redirect('/destination\r\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: 1')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() percent-encodes raw CR and LF separately', () => {
+    let res = c.redirect('/destination\rstart')
+    expect(res.headers.get('Location')).toBe('/destination%0Dstart')
+    res = c.redirect('/destination\nstart')
+    expect(res.headers.get('Location')).toBe('/destination%0Astart')
+  })
+
+  it('c.redirect() percent-encodes CR and LF in multibyte locations', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: 1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%201'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  const percentEncodedCRLFURLString = [
+    '/destination%0D%0AX-Injected:%201',
+    '/destination%0d%0aX-Injected:%201',
+    'https://example.com/destination?next=%0D%0A',
+  ]
+
+  percentEncodedCRLFURLString.forEach((urlString) => {
+    it(`c.redirect() preserves percent-encoded CRLF in ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
+
