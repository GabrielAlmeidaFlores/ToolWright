index 1fa06da..1a77b5b 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,34 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() percent-encodes raw CR/LF', () => {
+    const cases: [string, string][] = [
+      ['https://example.com/\rfoo', 'https://example.com/%0Dfoo'],
+      ['https://example.com/\nfoo', 'https://example.com/%0Afoo'],
+      ['https://example.com/\r\nfoo', 'https://example.com/%0D%0Afoo'],
+    ]
+    for (const [input, expected] of cases) {
+      const res = new Context(req).redirect(input)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(expected)
+    }
+  })
+
+  it('c.redirect() prevents header injection via CR/LF', () => {
+    const res = new Context(req).redirect('https://example.com/\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%0D%0ASet-Cookie: injected=1'
+    )
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() preserves percent-encoded CR/LF input', () => {
+    const res = new Context(req).redirect('https://example.com/%0D%0Afoo')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0Afoo')
+  })
+
   it('c.body() - Blob', async () => {
     const res = c.body(new Blob(['Hi']))
     expect(await res.text()).toBe('Hi')
