+  it('c.redirect() encodes raw CR in Location', () => {
+    const res = c.redirect('/destination\rX-Injected: evil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: evil')
+  })
+
+  it('c.redirect() encodes raw LF in Location', () => {
+    const res = c.redirect('/destination\nX-Injected: evil')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: evil')
+  })
+
+  it('c.redirect() encodes raw CRLF in Location', () => {
+    const res = c.redirect('/destination\r\nX-Injected: evil')
+    expect(res.status).toBe(302)
+    const location = res.headers.get('Location')
+    expect(location).toBe('/destination%0D%0AX-Injected: evil')
+    expect(location).not.toContain('\r')
+    expect(location).not.toContain('\n')
+  })
+
+  it('c.redirect() preserves percent-encoded CRLF in Location', () => {
+    const location = '/destination%0D%0AX-Injected: evil'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
+
+  it('c.redirect() preserves lowercase percent-encoded CRLF in Location', () => {
+    const location = '/destination%0d%0aX-Injected: evil'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
