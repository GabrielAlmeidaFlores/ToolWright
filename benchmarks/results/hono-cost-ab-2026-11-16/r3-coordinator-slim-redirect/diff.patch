+  describe('c.redirect() header injection', () => {
+    it('c.redirect() should percent-encode raw CR and LF in Location', () => {
+      const res = c.redirect('/destination\r\nX-Injected: 1')
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: 1')
+      // The injected header must not become a real response header
+      expect(res.headers.get('X-Injected')).toBeNull()
+    })
+
+    it('c.redirect() should percent-encode lone CR and lone LF', () => {
+      expect(c.redirect('/a\rb').headers.get('Location')).toBe('/a%0Db')
+      expect(c.redirect('/a\nb').headers.get('Location')).toBe('/a%0Ab')
+    })
+
+    it('c.redirect() should keep the requested status when encoding CR/LF', () => {
+      const res = c.redirect('/destination\r\n', 301)
+      expect(res.status).toBe(301)
+      expect(res.headers.get('Location')).toBe('/destination%0D%0A')
+    })
+
+    it('c.redirect() should encode CR/LF together with multibyte chars', () => {
+      const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: 1')
+      expect(res.headers.get('Location')).toBe(
+        'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%201'
+      )
+      expect(res.headers.get('X-Injected')).toBeNull()
+    })
+
+    const percentEncodedURLString = [
+      'https://example.com/%0D%0A',
+      '/destination%0d%0aX-Injected%3A%201',
+      'https://example.com/path?next=%0A',
+    ]
+
+    percentEncodedURLString.forEach((urlString) => {
+      it(`c.redirect() should not double-encode ${urlString}`, () => {
+        const res = c.redirect(urlString)
+        expect(res.status).toBe(302)
+        expect(res.headers.get('Location')).toBe(urlString)
+      })
+    })
+  })
+
