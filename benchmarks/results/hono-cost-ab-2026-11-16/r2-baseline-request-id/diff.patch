+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/default', requestId({ generator: () => 'generated-id' }))
+  app.use('/trust', requestId({ generator: () => 'generated-id', trustIncoming: true }))
+  app.use('/no-trust', requestId({ generator: () => 'generated-id', trustIncoming: false }))
+  app.use(
+    '/no-trust-custom-header',
+    requestId({
+      generator: () => 'generated-id',
+      headerName: 'Hono-Request-Id',
+      trustIncoming: false,
+    })
+  )
+  app.get('/default', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust-custom-header', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/default', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should use the generator when trustIncoming is false and no request id header is sent', async () => {
+    const res = await app.request('http://localhost/no-trust')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should ignore a custom incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust-custom-header', {
+      headers: {
+        'Hono-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
+
 describe('Request ID Middleware with custom header', () => {
   const app = new Hono()
   app.use('/requestId', requestId({ headerName: 'Hono-Request-Id' }))
