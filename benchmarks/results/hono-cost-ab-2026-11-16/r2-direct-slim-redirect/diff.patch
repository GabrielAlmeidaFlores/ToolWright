+  it('c.redirect() encodes raw CR and LF to prevent header injection', () => {
+    let res = c.redirect('/destination\r\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0D%0AX-Injected: true')
+    expect(res.headers.get('X-Injected')).toBeNull()
+
+    res = c.redirect('/destination\rX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0DX-Injected: true')
+    expect(res.headers.get('X-Injected')).toBeNull()
+
+    res = c.redirect('/destination\nX-Injected: true')
+    expect(res.headers.get('Location')).toBe('/destination%0AX-Injected: true')
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() does not re-encode percent-encoded CR and LF', () => {
+    const encodedCRLF = 'https://example.com/%0D%0ASet-Cookie:injected=1'
+    expect(c.redirect(encodedCRLF).headers.get('Location')).toBe(encodedCRLF)
+
+    const encodedLowercase = 'https://example.com/%0d%0a'
+    expect(c.redirect(encodedLowercase).headers.get('Location')).toBe(encodedLowercase)
+  })
