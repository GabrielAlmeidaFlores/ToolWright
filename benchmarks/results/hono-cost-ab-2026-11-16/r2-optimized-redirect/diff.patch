+  it('c.redirect() percent-encodes raw CR and LF in Location', () => {
+    const cases: [string, string][] = [
+      ['/destination\r\nSet-Cookie: injected=1', '/destination%0D%0ASet-Cookie: injected=1'],
+      ['/destination\r/next', '/destination%0D/next'],
+      ['/destination\n/next', '/destination%0A/next'],
+    ]
+    for (const [input, expected] of cases) {
+      const res = new Context(req).redirect(input)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(expected)
+      // The injected header must not be present.
+      expect(res.headers.get('Set-Cookie')).toBeNull()
+    }
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR and LF', () => {
+    const cases = [
+      '/destination%0D%0Anext',
+      '/destination%0d%0anext',
+      'https://example.com/%0D%0ASet-Cookie:injected=1',
+    ]
+    for (const input of cases) {
+      const res = new Context(req).redirect(input)
+      expect(res.headers.get('Location')).toBe(input)
+    }
+  })
+
