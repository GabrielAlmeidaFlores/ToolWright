+  it('c.redirect() encodes raw CR/LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+
+    expect(c.redirect('/carriage\rreturn').headers.get('Location')).toBe('/carriage%0Dreturn')
+    expect(c.redirect('/line\nfeed').headers.get('Location')).toBe('/line%0Afeed')
+  })
+
+  const encodedCRLFString = [
+    '/destination%0d%0aSet-Cookie: injected=1',
+    '/destination%0D%0ASet-Cookie: injected=1',
+    'https://example.com/%0d%0a',
+    'https://example.com/%0D%0A',
+  ]
+
+  encodedCRLFString.forEach((urlString) => {
+    it(`c.redirect() preserves percent-encoded CR/LF in ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
