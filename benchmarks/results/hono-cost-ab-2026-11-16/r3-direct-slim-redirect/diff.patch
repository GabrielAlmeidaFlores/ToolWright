+  it('c.redirect() should percent-encode CR/LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() should percent-encode a lone CR and a lone LF', () => {
+    expect(c.redirect('/destination\rfoo').headers.get('Location')).toBe(
+      '/destination%0Dfoo'
+    )
+    expect(c.redirect('/destination\nfoo').headers.get('Location')).toBe(
+      '/destination%0Afoo'
+    )
+  })
+
+  it('c.redirect() should percent-encode CR/LF with multibyte characters', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\n')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A'
+    )
+  })
+
