+describe('Request ID Middleware with trustIncoming', () => {
+  function generateWord() {
+    return 'HonoIsWebFramework'
+  }
+
+  const app = new Hono()
+  app.use('/trusted', requestId())
+  app.use('/untrusted', requestId({ trustIncoming: false }))
+  app.use('/untrustedWithGenerator', requestId({ trustIncoming: false, generator: generateWord }))
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedWithGenerator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id header by default', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('hono-is-hot')
+    expect(await res.text()).toBe('hono-is-hot')
+  })
+
+  it('Should ignore the incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    const requestIdHeader = res.headers.get('X-Request-Id')
+    const body = await res.text()
+    expect(requestIdHeader).toMatch(regexUUIDv4)
+    expect(requestIdHeader).not.toBe('hono-is-hot')
+    expect(body).toMatch(regexUUIDv4)
+    expect(body).not.toBe('hono-is-hot')
+  })
+
+  it('Should use the configured generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedWithGenerator', {
+      headers: {
+        'X-Request-Id': 'hono-is-hot',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('HonoIsWebFramework')
+    expect(await res.text()).toBe('HonoIsWebFramework')
+  })
+})
+
