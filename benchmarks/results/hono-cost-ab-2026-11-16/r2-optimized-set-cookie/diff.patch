+  it('Should keep middleware cookies and raw Response cookies when re-assigning `c.res`', () => {
+    // Middleware has already set a cookie on the current response
+    c.res.headers.set('X-Something', 'true')
+    setCookie(c, 'middleware', '1', { path: '/' })
+
+    // Handler returns a new Response with its own Set-Cookie header
+    const newResponse = new Response('ok')
+    newResponse.headers.append('set-cookie', 'handler=1; Path=/; HttpOnly')
+
+    c.res = newResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'handler=1; Path=/; HttpOnly',
+      'middleware=1; Path=/',
+    ])
+    expect(c.res.headers.get('X-Something')).toBe('true')
+  })
+
+  it('Should keep prepared cookies when assigning a raw Response to c.res', () => {
+    // The cookie is still in `#preparedHeaders` because `c.res` was not read
+    setCookie(c, 'middleware', '1', { path: '/' })
+
+    const newResponse = new Response('ok')
+    newResponse.headers.append('set-cookie', 'handler=1; Path=/')
+
+    c.res = newResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual(['handler=1; Path=/', 'middleware=1; Path=/'])
+  })
+
+  it('Should not duplicate cookies when merging multiple middleware cookies', () => {
+    c.res.headers.set('X-Something', 'true')
+    setCookie(c, 'a', '1', { path: '/' })
+    setCookie(c, 'b', '2', { path: '/' })
+
+    const newResponse = new Response('ok')
+    newResponse.headers.append('set-cookie', 'handler=1; Path=/')
+
+    c.res = newResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'handler=1; Path=/',
+      'a=1; Path=/',
+      'b=2; Path=/',
+    ])
+  })
+
