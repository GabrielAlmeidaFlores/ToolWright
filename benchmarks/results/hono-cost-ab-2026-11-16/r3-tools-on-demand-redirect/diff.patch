+  it('c.redirect() percent-encodes raw CR/LF to prevent header injection', async () => {
+    const cases = [
+      { input: '/destination\rX-Injected: yes', expected: '/destination%0DX-Injected: yes' },
+      { input: '/destination\nX-Injected: yes', expected: '/destination%0AX-Injected: yes' },
+      { input: '/destination\r\nX-Injected: yes', expected: '/destination%0D%0AX-Injected: yes' },
+    ]
+    for (const { input, expected } of cases) {
+      const res = c.redirect(input)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(expected)
+      expect(res.headers.get('X-Injected')).toBeNull()
+    }
+  })
+
+  it('c.redirect() preserves already percent-encoded CR/LF', async () => {
+    const location = '/destination%0D%0AX-Injected:%20yes'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() encodes CR/LF alongside multibytes without double-encoding', async () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: yes')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%20yes'
+    )
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
   it('c.body() - Blob', async () => {
