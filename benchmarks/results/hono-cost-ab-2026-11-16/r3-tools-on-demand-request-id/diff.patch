diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..ffc09a4 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,69 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming option', () => {
+  const app = new Hono()
+  app.use('/trust', requestId({ trustIncoming: true, generator: () => 'generated-id' }))
+  app.use('/no-trust', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/no-trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use incoming request id when trustIncoming is true', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/no-trust', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should use the generator when trustIncoming is false and no header is sent', async () => {
+    const res = await app.request('http://localhost/no-trust')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+
+  it('Should default trustIncoming to true', async () => {
+    const defaultApp = new Hono()
+    defaultApp.use('*', requestId({ generator: () => 'generated-id' }))
+    defaultApp.get('/', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+    const res = await defaultApp.request('http://localhost/', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should expose generated id via response header and c.get with a custom headerName', async () => {
+    const customApp = new Hono()
+    customApp.use(
+      '*',
+      requestId({
+        trustIncoming: false,
+        headerName: 'Hono-Request-Id',
+        generator: () => 'generated-id',
+      })
+    )
+    customApp.get('/', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+    const res = await customApp.request('http://localhost/', {
+      headers: { 'Hono-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
