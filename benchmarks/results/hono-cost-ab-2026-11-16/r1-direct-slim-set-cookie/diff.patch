+
+  it('Should merge cookies when a handler returns a new Response with its own Set-Cookie', () => {
+    // Middleware sets a cookie on `c.res` before the handler runs.
+    c.res.headers.append('set-cookie', 'middleware=hello; Path=/')
+
+    // The handler returns a brand new Response carrying its own cookie.
+    const handlerResponse = new Response('ok', {
+      headers: { 'set-cookie': 'handler=world; Path=/; HttpOnly' },
+    })
+    c.res = handlerResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'middleware=hello; Path=/',
+      'handler=world; Path=/; HttpOnly',
+    ])
+  })
+
+  it('Should merge cookies staged via c.header() before assigning a raw Response', () => {
+    // Mimics middleware that sets a cookie before `c.res` has been read.
+    c.header('Set-Cookie', 'middleware=hello; Path=/', { append: true })
+
+    const handlerResponse = new Response('ok')
+    handlerResponse.headers.append('set-cookie', 'handler=world; Path=/; HttpOnly')
+    c.res = handlerResponse
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'middleware=hello; Path=/',
+      'handler=world; Path=/; HttpOnly',
+    ])
+  })
+
+  it('Should not duplicate cookies when the Response already contains them', () => {
+    c.header('Set-Cookie', 'foo=bar; Path=/', { append: true })
+    c.res = c.text('ok')
+
+    expect(c.res.headers.getSetCookie()).toEqual(['foo=bar; Path=/'])
   })
 
