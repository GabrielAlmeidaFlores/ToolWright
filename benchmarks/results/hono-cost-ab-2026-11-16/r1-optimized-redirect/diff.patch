+  it('c.redirect() percent-encodes raw CR/LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+  })
+
+  it('c.redirect() percent-encodes raw CR and LF separately', () => {
+    expect(c.redirect('/a\rb').headers.get('Location')).toBe('/a%0Db')
+    expect(c.redirect('/a\nb').headers.get('Location')).toBe('/a%0Ab')
+  })
+
+  it('c.redirect() preserves already percent-encoded CR/LF', () => {
+    const location = '/destination%0D%0ASet-Cookie:%20injected=1'
+    const res = c.redirect(location)
+    expect(res.headers.get('Location')).toBe(location)
+  })
+
+  it('c.redirect() percent-encodes CR/LF in multibyte locations', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected: 1')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:%201'
+    )
+  })
+
