+    c.res = new Response(null)
+    setCookie(c, 'middleware', '1', { path: '/' })
+
+    // The handler returns a new Response with its own Set-Cookie header.
+    const handlerResponse = new Response('ok', {
+      headers: {
+        'set-cookie': 'handler=2; Path=/',
+      },
+    })
+    c.res = handlerResponse
+
+    const cookies = c.res.headers.getSetCookie()
+    expect(cookies).toHaveLength(2)
