+  it('c.redirect() percent-encodes raw CR and LF', () => {
+    let res = c.redirect('https://example.com/\r')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D')
+
+    res = c.redirect('https://example.com/\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0A')
+
+    res = c.redirect('https://example.com/\r\nSet-Cookie: injected=true')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('https://example.com/%0D%0ASet-Cookie: injected=true')
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF', () => {
+    const location = 'https://example.com/%0D%0ASet-Cookie:%20injected=true'
+    const res = c.redirect(location)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(location)
+  })
