+
+  it('Should merge Set-Cookie headers when the middleware already set a cookie on c.res', () => {
+    // Simulate middleware such as CORS accessing `c.res` (which materializes
+    // it) and setting a cookie on that response.
+    c.res.headers.append('x-middleware', 'true')
+    setCookie(c, 'session', 'middleware', { path: '/' })
+
+    // The handler returns a new Response carrying its own Set-Cookie header.
+    const res = new Response('ok', {
+      headers: [['set-cookie', 'token=handler; Path=/']],
+    })
+    c.res = res
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'session=middleware; Path=/',
+      'token=handler; Path=/',
+    ])
+    expect(c.res.headers.get('x-middleware')).toBe('true')
+    expect(c.res.status).toBe(200)
+  })
+
+  it('Should merge prepared Set-Cookie headers into an assigned raw Response', () => {
+    // No middleware read `c.res` yet, so the cookie is staged in the prepared
+    // headers instead of being written to a materialized response.
+    setCookie(c, 'session', 'prepared', { path: '/' })
+
+    const res = new Response('ok', {
+      headers: [['set-cookie', 'token=handler; Path=/']],
+    })
+    c.res = res
+
+    expect(c.res.headers.getSetCookie()).toEqual([
+      'session=prepared; Path=/',
+      'token=handler; Path=/',
+    ])
   })
 
