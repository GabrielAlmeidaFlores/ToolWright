+  it('c.redirect() percent-encodes raw CR and LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: injected=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: injected=1')
+    expect(res.headers.get('Location')).not.toMatch(/[\r\n]/)
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() percent-encodes a lone CR and LF', () => {
+    expect(c.redirect('/destination\rwith-cr').headers.get('Location')).toBe(
+      '/destination%0Dwith-cr'
+    )
+    expect(c.redirect('/destination\nwith-lf').headers.get('Location')).toBe(
+      '/destination%0Awith-lf'
+    )
+  })
+
+  it('c.redirect() percent-encodes raw CR and LF alongside multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\nX-Injected:yes')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0AX-Injected:yes'
+    )
+    expect(res.headers.get('Location')).not.toMatch(/[\r\n]/)
+  })
+
+  it('c.redirect() preserves percent-encoded CR and LF', () => {
+    const url = 'https://example.com/destination%0D%0ASet-Cookie:%20injected=1'
+    const res = c.redirect(url)
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(url)
+  })
+
+  it('c.redirect() preserves lowercase percent-encoded CR and LF', () => {
+    const url = 'https://example.com/destination%0d%0aX-Injected:%20yes'
+    const res = c.redirect(url)
+    expect(res.headers.get('Location')).toBe(url)
+  })
+
   const unchangedURLString = [
