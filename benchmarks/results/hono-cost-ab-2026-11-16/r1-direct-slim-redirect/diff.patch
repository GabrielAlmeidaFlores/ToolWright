diff --git a/src/context.ts b/src/context.ts
index 6db8717..0281324 100644
--- a/src/context.ts
+++ b/src/context.ts
@@ -770,11 +770,17 @@ export class Context<
     status?: T
   ): Response & TypedResponse<undefined, T, 'redirect'> => {
     const locationString = String(location)
-    this.header(
-      'Location',
+    const encodedLocation =
       // Multibytes should be encoded
       // eslint-disable-next-line no-control-regex
       !/[^\x00-\xFF]/.test(locationString) ? locationString : encodeURI(locationString)
+    this.header(
+      'Location',
+      // CR and LF must never be emitted raw in a header value, otherwise they can
+      // be used to inject additional headers (e.g. `Set-Cookie`). Percent-encoding
+      // them keeps the redirect valid while neutralising the injection. Existing
+      // percent-encoded sequences (e.g. `%0D%0A`) are left untouched.
+      encodedLocation.replace(/[\r\n]/g, (char) => (char === '\r' ? '%0D' : '%0A'))
     )
     return this.newResponse(null, status ?? 302) as any
   }
