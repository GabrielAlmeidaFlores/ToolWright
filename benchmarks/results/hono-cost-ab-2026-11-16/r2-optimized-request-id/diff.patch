@@ -166,3 +166,83 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const generatedId = 'generated-request-id'
+  const app = new Hono()
+  app.use('/trusted', requestId({ generator: () => generatedId }))
+  app.use('/untrusted', requestId({ generator: () => generatedId, trustIncoming: false }))
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({
+      headerName: 'Hono-Request-Id',
+      generator: () => generatedId,
+      trustIncoming: false,
+    })
+  )
+  app.use(
+    '/untrustedEmptyHeader',
+    requestId({ generator: () => generatedId, trustIncoming: false, headerName: '' })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedEmptyHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should trust the incoming request id when trustIncoming is explicitly true', async () => {
+    const trustedApp = new Hono()
+    trustedApp.use('*', requestId({ generator: () => generatedId, trustIncoming: true }))
+    trustedApp.get('/', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+    const res = await trustedApp.request('http://localhost/', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should ignore the incoming custom header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: { 'Hono-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe(generatedId)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should generate an id when trustIncoming is false and no header is present', async () => {
+    const res = await app.request('http://localhost/untrusted')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe(generatedId)
+    expect(await res.text()).toBe(generatedId)
+  })
+
+  it('Should generate an id when trustIncoming is false and headerName is empty', async () => {
+    const res = await app.request('http://localhost/untrustedEmptyHeader', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe(generatedId)
+  })
+})
