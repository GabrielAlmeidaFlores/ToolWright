+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/trusted', requestId({ trustIncoming: true }))
+  app.use('/untrusted', requestId({ trustIncoming: false }))
+  app.use(
+    '/untrustedCustomGenerator',
+    requestId({ trustIncoming: false, generator: () => 'GeneratedRequestId' })
+  )
+  app.use(
+    '/untrustedCustomHeader',
+    requestId({ trustIncoming: false, headerName: 'Hono-Request-Id', generator: () => 'Generated' })
+  )
+  app.get('/trusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrusted', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomGenerator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/untrustedCustomHeader', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should trust the incoming request id by default', async () => {
+    const res = await app.request('http://localhost/trusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should ignore the incoming request id when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrusted', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(res.headers.get('X-Request-Id')).not.toBe('incoming-id')
+    expect(await res.text()).toMatch(regexUUIDv4)
+  })
+
+  it('Should use the configured generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomGenerator', {
+      headers: {
+        'X-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('GeneratedRequestId')
+    expect(await res.text()).toBe('GeneratedRequestId')
+  })
+
+  it('Should set the configured response header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/untrustedCustomHeader', {
+      headers: {
+        'Hono-Request-Id': 'incoming-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Hono-Request-Id')).toBe('Generated')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('Generated')
+  })
+})
+
