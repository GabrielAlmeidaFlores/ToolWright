index 1fa06da..8005160 100644
--- a/src/context.test.ts
+++ b/src/context.test.ts
@@ -129,6 +129,49 @@ describe('Context', () => {
     })
   })
 
+  it('c.redirect() percent-encodes raw CR and LF', () => {
+    let res = c.redirect('/destination\r')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D')
+
+    res = c.redirect('/destination\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0A')
+
+    res = c.redirect('/destination\r\n')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0A')
+  })
+
+  it('c.redirect() prevents CRLF header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: evil=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: evil=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+    expect(res.headers.get('X-Injected')).toBeNull()
+  })
+
+  it('c.redirect() percent-encodes CR and LF together with multibytes', () => {
+    const res = c.redirect('https://example.com/こんにちは\r\n')
+    expect(res.headers.get('Location')).toBe(
+      'https://example.com/%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%0D%0A'
+    )
+  })
+
+  const percentEncodedCRLF = [
+    'https://example.com/%0D%0A',
+    'https://example.com/path?next=%0A%0D',
+    'https://example.com/path%0Dwith%0Aencoded',
+  ]
+
+  percentEncodedCRLF.forEach((urlString) => {
+    it(`c.redirect() preserves already percent-encoded CR/LF: ${urlString}`, () => {
+      const res = c.redirect(urlString)
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toBe(urlString)
+    })
+  })
+
   it('c.body() - Blob', async () => {
