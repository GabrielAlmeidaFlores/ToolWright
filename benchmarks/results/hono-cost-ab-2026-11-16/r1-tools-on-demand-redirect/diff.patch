+  it('c.redirect() encodes raw CR/LF to prevent header injection', () => {
+    const res = c.redirect('/destination\r\nSet-Cookie: hacked=1')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/destination%0D%0ASet-Cookie: hacked=1')
+    expect(res.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it('c.redirect() encodes lone CR and LF', () => {
+    expect(c.redirect('/destination\rX-Injected: true').headers.get('Location')).toBe(
+      '/destination%0DX-Injected: true'
+    )
+    expect(c.redirect('/destination\nX-Injected: true').headers.get('Location')).toBe(
+      '/destination%0AX-Injected: true'
+    )
+  })
+
+  it('c.redirect() does not double-encode percent-encoded CR/LF', () => {
+    const locations = [
+      '/destination%0D%0ASet-Cookie: hacked=1',
+      '/destination%0d%0aSet-Cookie: hacked=1',
+      '/destination%0D%0A',
+      '/destination%0d%0a',
+    ]
+    for (const location of locations) {
+      expect(c.redirect(location).headers.get('Location')).toBe(location)
+    }
+  })
+
   const unchangedURLString = [
