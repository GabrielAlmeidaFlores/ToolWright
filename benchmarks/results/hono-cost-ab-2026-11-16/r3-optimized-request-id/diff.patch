diff --git a/src/middleware/request-id/index.test.ts b/src/middleware/request-id/index.test.ts
index b00a0e6..d7d6ced 100644
--- a/src/middleware/request-id/index.test.ts
+++ b/src/middleware/request-id/index.test.ts
@@ -166,3 +166,52 @@ describe('Request ID Middleware with custom header', () => {
     expect(await res.text()).toMatch(regexUUIDv4)
   })
 })
+
+describe('Request ID Middleware with trustIncoming', () => {
+  const app = new Hono()
+  app.use('/trust', requestId({ trustIncoming: true }))
+  app.use('/noTrust', requestId({ trustIncoming: false }))
+  app.use('/noTrustGenerator', requestId({ trustIncoming: false, generator: () => 'generated-id' }))
+  app.get('/trust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/noTrust', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+  app.get('/noTrustGenerator', (c) => c.text(c.get('requestId') ?? 'No Request ID'))
+
+  it('Should use incoming request id header by default', async () => {
+    const res = await app.request('http://localhost/trust', {
+      headers: {
+        'X-Request-Id': 'trusted-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('trusted-id')
+    expect(await res.text()).toBe('trusted-id')
+  })
+
+  it('Should ignore incoming request id header when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/noTrust', {
+      headers: {
+        'X-Request-Id': 'trusted-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toMatch(regexUUIDv4)
+    expect(res.headers.get('X-Request-Id')).not.toBe('trusted-id')
+    const body = await res.text()
+    expect(body).toMatch(regexUUIDv4)
+    expect(body).not.toBe('trusted-id')
+  })
+
+  it('Should use the configured generator when trustIncoming is false', async () => {
+    const res = await app.request('http://localhost/noTrustGenerator', {
+      headers: {
+        'X-Request-Id': 'trusted-id',
+      },
+    })
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Request-Id')).toBe('generated-id')
+    expect(await res.text()).toBe('generated-id')
+  })
+})
